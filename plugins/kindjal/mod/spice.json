  "weapons": [
    {
      "name": "kWeaponAcidSpitter",
      "base": "kWeaponBazooka",
      "cell": 29,
      "set": {
        "WormDamageMagnitude": 35,
        "WormDamageRadius": 70,
        "LandDamageRadius": 45,
        "ImpulseMagnitude": 0.25,
        "DetonationFx": "WXP_Explosion_Gas",
        "ArielFx": "WXP_ExplosionG_Tail",
        "PayloadGraphicsResourceID": "kindjal.AcidRound"
      },
      "panelIcon": "icons/acid-spitter.png",
      "hudIcon": "kindjal.acid-spitter.hud.tga",
      "text": {
        "name": "Acid Spitter",
        "help": "Spits a corrosive round. The burst is poison gas, and the acid clings to whatever it touches."
      }
    },
    {
      "name": "kWeaponAcidFlask",
      "base": "kWeaponGrenade",
      "cell": 39,
      "set": {
        "WormDamageMagnitude": 25,
        "WormDamageRadius": 60,
        "LandDamageRadius": 35,
        "ImpulseMagnitude": 0.15,
        "DetonatesOnLandImpact": true,
        "DetonatesOnWormImpact": true,
        "DetonatesOnObjectImpact": true,
        "HasAdjustableFuse": false,
        "HasAdjustableBounce": false,
        "DetonationFx": "WXP_PoisonArrowPuffOut",
        "PayloadGraphicsResourceID": "kindjal.AcidFlask",
        "WeaponGraphicsResourceID": "kindjal.AcidFlask"
      },
      "panelIcon": "icons/acid-flask.png",
      "hudIcon": "kindjal.acid-flask.hud.tga",
      "text": {
        "name": "Acid Flask",
        "help": "Shatters where it lands and splashes acid to both sides. Poisons everything in the spill."
      }
    },
    {
      "name": "kWeaponCrucible",
      "base": "kWeaponHolyHandGrenade",
      "cell": 40,
      "set": {
        "WormDamageMagnitude": 120,
        "WormDamageRadius": 243,
        "LandDamageRadius": 168,
        "ImpulseMagnitude": 1.35,
        "ImpulseRadius": 195,
        "PreDetonationTime": 0,
        "DetonationFx": "WXP_ExplosionX_Large",
        "DetonationSfx": "weapons/ExplosionLarge",
        "PayloadGraphicsResourceID": "kindjal.Crucible",
        "WeaponGraphicsResourceID": "kindjal.Crucible"
      },
      "panelIcon": "icons/crucible.png",
      "hudIcon": "kindjal.crucible.hud.tga",
      "text": {
        "name": "Crucible",
        "help": "No choir, no pause. Melts the ground it lands on and hurls everything nearby into the sky."
      }
    }
  ],
  "weaponText": {
    "kWeaponBaseballBat": {
      "name": "Nail Bat",
      "help": "A bat studded with nails. Hits harder and sends the victim flying."
    },
    "kWeaponFirePunch": {
      "name": "Hellfist",
      "help": "An uppercut that detonates on contact and launches the victim."
    },
    "kWeaponProd": {
      "name": "Shiv",
      "help": "A stab that bleeds, with a shove behind it."
    },
    "kWeaponNoMoreNails": {
      "name": "Railspike",
      "help": "Spikes driven straight in. Twice the hurt of a nail."
    },
    "kWeaponBazooka": {
      "name": "Ripper",
      "help": "A heavier rocket: bigger blast, far more knockback."
    },
    "kWeaponGrenade": {
      "name": "Pipe Bomb",
      "help": "Concentrated charge. Fewer victims, much deadlier."
    },
    "kWeaponDynamite": {
      "name": "Blast Keg",
      "help": "Clears a hillside and everyone on it."
    },
    "kWeaponHolyHandGrenade": {
      "name": "Profane Grenade",
      "help": "The old miracle, stripped of mercy."
    },
    "kWeaponBananaBomb": {
      "name": "Plantain Hell",
      "help": "Splits into seven bomblets that throw worms around."
    },
    "kWeaponClusterGrenade": {
      "name": "Nail Cluster",
      "help": "Every fragment now hurts and shoves."
    },
    "kWeaponLandmine": {
      "name": "Bear Trap",
      "help": "Stepping on one is a real event."
    },
    "kWeaponHomingMissile": {
      "name": "Harpoon",
      "help": "Guided displacement. Pulls worms off their perches."
    },
    "kWeaponAirstrike": {
      "name": "Carpet Bombing",
      "help": "Heavier bombs, bigger craters, worms in the air."
    },
    "kWeaponSuperAirstrike": {
      "name": "Carrion Drop",
      "help": "Three carcasses from the sky. Nothing walks away."
    },
    "kWeaponConcreteDonkey": {
      "name": "Earthquake Ass",
      "help": "Cataclysmic terrain loss. Everything near it is airborne."
    },
    "kWeaponSheep": {
      "name": "Rabid Flock",
      "help": "The sheep that ends a worm."
    },
    "kWeaponSuperSheep": {
      "name": "Plague Ram",
      "help": "Flies like the old one, kills like the new one."
    },
    "kWeaponOldWoman": {
      "name": "Hangwoman",
      "help": "Shuffles over and throws everyone off the ledge."
    },
    "kWeaponScouser": {
      "name": "Knifeman",
      "help": "Hits harder and shoves when he bursts."
    },
    "kWeaponFatkins": {
      "name": "Gorger",
      "help": "Lands like a meteor; the whole area goes flying."
    },
    "kWeaponStarburst": {
      "name": "Dead Star",
      "help": "A falling star that hurls worms across the map."
    },
    "kWeaponShotgun": {
      "name": "Slug Gun",
      "help": "Two slugs, fifty each. Both land, the worm dies."
    },
    "kWeaponSniperRifle": {
      "name": "Elephant Gun",
      "help": "The impact matters more than the hole."
    },
    "kWeaponSentryGun": {
      "name": "Gibbet Turret",
      "help": "A turret that fires Ripper-class rounds."
    },
    "kWeaponPoisonArrow": {
      "name": "Plague Arrow",
      "help": "Hits harder; the plague cloud is unchanged."
    },
    "kWeaponGasCanister": {
      "name": "Rust Canister",
      "help": "Gas and a blast."
    }
  },
