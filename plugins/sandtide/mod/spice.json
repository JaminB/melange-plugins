{
  "spiceVersion": 1,
  "id": "sandtide",
  "version": "1.0.1",
  "name": "Sandtide",
  "authors": [
    "Melange"
  ],
  "description": "Adds the Sandworms game style, played with the Kindjal weapons. At 3:00 the hourglass empties and every worm below the sand line has its tail turned to sand: it keeps its turns and can aim and fire, but it can never move again. At 5:00 the water rises. Content mod: every player in an online match needs it.",
  "website": "https://github.com/JaminB/melange-plugins/tree/main/plugins/sandtide",
  "kind": "content",
  "melange": {
    "range": ">=0.11.0"
  },
  "permissions": {
    "unsafe": false,
    "filesystem": "none"
  },
  "dependencies": [
    "kindjal >=1.3.1"
  ],
  "conflicts": [],
  "entry": {
    "sim": "sim/main.lua",
    "client": "client/init.lua"
  },
  "messages": [
    "Sandtide.Line",
    "Sandtide.Curse"
  ],
  "schemes": [
    {
      "file": "schemes/sandworms.json"
    }
  ],
  "settings": [
    {
      "key": "cameraTour",
      "type": "bool",
      "default": true,
      "label": "Camera tour of the cursed worms"
    },
    {
      "key": "fx",
      "type": "enum",
      "options": [
        "subtle",
        "full",
        "dramatic"
      ],
      "default": "dramatic",
      "label": "Curse effects (dust, shake, sand)"
    },
    {
      "key": "hourglassScale",
      "type": "float",
      "min": 0.5,
      "max": 2.0,
      "default": 1.0,
      "label": "Hourglass size"
    },
    {
      "key": "volume",
      "type": "int",
      "min": 0,
      "max": 100,
      "default": 60,
      "label": "Sound volume"
    }
  ]
}
