{
  "spiceVersion": 1,
  "id": "kanly",
  "version": "1.1.0",
  "name": "Kanly",
  "authors": ["Melange"],
  "description": "Adds a Kanly game style (five-minute rounds, then fast-rising water, a generous loadout), four Kanly Weapon Factory presets and Kanly sudden-death music. Also fixes controls (camera and aim invert, mouse sensitivity) and shows short on-screen control hints and a controls legend. Client-side.",
  "website": "https://github.com/JaminB/melange-plugins/tree/main/plugins/kanly",
  "kind": "client-only",
  "melange": { "range": ">=0.8.0" },
  "permissions": { "unsafe": false, "filesystem": "none" },
  "dependencies": [],
  "conflicts": [],
  "entry": { "client": "client/init.lua" },
  "schemes": [{ "file": "schemes/kanly.json" }],
  "music": [
    { "slot": "suddenDeath", "file": "music/ash-ridge.mp3", "title": "Ash Ridge", "credit": "Slaughter at Ash Ridge" },
    { "slot": "suddenDeath", "file": "music/ash-ridge-reprise.mp3", "title": "Ash Ridge Reprise", "credit": "Slaughter at Ash Ridge (second mix)" },
    { "slot": "suddenDeath", "file": "music/alabaster-purge.mp3", "title": "Alabaster Purge", "credit": "The Alabaster Purge (violin) x Ashes of Elysium (piano) mashup" },
    { "slot": "suddenDeath", "file": "music/elysium-ashes.mp3", "title": "Elysium Ashes", "credit": "Ashes of Elysium (piano) x Ashes of Elysium mashup" }
  ],
  "factoryWeapons": [
    { "file": "weapons/red.json" },
    { "file": "weapons/blue.json" },
    { "file": "weapons/green.json" },
    { "file": "weapons/yellow.json" }
  ],
  "settings": [
    { "key": "cameraInvertY", "type": "enum", "options": ["game", "standard", "inverted"], "default": "standard", "label": "3rd-person camera Y" },
    { "key": "aimInvertY", "type": "enum", "options": ["game", "standard", "inverted"], "default": "game", "label": "Aim Y (first person)" },
    { "key": "blimpInvert", "type": "bool", "default": true, "label": "Apply camera invert in Blimp view" },
    { "key": "cameraSensitivity", "type": "float", "min": 0.25, "max": 3.0, "default": 1.0, "label": "Camera sensitivity" },
    { "key": "aimSensitivity", "type": "float", "min": 0.25, "max": 3.0, "default": 1.0, "label": "Aim sensitivity" },
    { "key": "hints", "type": "enum", "options": ["off", "learning", "always"], "default": "learning", "label": "Control hints" },
    { "key": "legendKey", "type": "enum", "options": ["F1", "Ctrl+H"], "default": "F1", "label": "Controls legend key" }
  ]
}
