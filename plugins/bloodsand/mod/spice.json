{
  "spiceVersion": 1,
  "id": "bloodsand",
  "version": "1.3.0",
  "name": "Bloodsand",
  "authors": ["Melange"],
  "description": "A client-only, cosmetic gore mod: worms spray blood when hit, wear it on their skin, open layered wounds, get black eyes, throw up blood, spill intestines, spurt from their arteries and leave trails and pools. Deaths and big hits throw meat, bone and organs. Droplets leave splats and drying pools; heavy hits spatter the lens. Only reads game state and draws. No effect on the simulation.",
  "website": "https://github.com/JaminB/melange-plugins/tree/main/plugins/bloodsand",
  "kind": "client-only",
  "melange": { "range": ">=0.3.5 <0.7.0" },
  "permissions": { "unsafe": false, "filesystem": "none" },
  "dependencies": [],
  "conflicts": [],
  "entry": { "client": "client/init.lua" },
  "settings": [
    {
      "key": "amount",
      "type": "enum",
      "options": ["off", "light", "heavy", "absurd"],
      "default": "heavy",
      "label": "Blood"
    },
    {
      "key": "skin",
      "type": "bool",
      "default": true,
      "label": "Blood on worms"
    },
    {
      "key": "vomit",
      "type": "bool",
      "default": true,
      "label": "Worms throw up blood"
    },
    {
      "key": "guts",
      "type": "bool",
      "default": true,
      "label": "Intestines"
    },
    {
      "key": "gibs",
      "type": "bool",
      "default": true,
      "label": "Gibs"
    },
    {
      "key": "stains",
      "type": "bool",
      "default": true,
      "label": "Blood on the ground"
    },
    {
      "key": "pools",
      "type": "bool",
      "default": true,
      "label": "Pools & trails"
    },
    {
      "key": "lens",
      "type": "bool",
      "default": true,
      "label": "Splatter on the lens"
    },
    {
      "key": "colour",
      "type": "enum",
      "options": ["red", "green"],
      "default": "red",
      "label": "Blood colour"
    }
  ]
}
