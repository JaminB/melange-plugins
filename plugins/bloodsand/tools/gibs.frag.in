#version 120
// Gibs, ray-marched. Bloodsand's Lua throws meat chunks, bones and organs out of a worm that dies or takes a very big hit,
// simulates them (flight, bounces, rolling, rest) and sends each live one as four vec4 uniforms: up to 16 slots at a time. Here
// each is a signed distance field in its own local frame, marched inside its bounding sphere: irregular meat chunks (a rounded
// box eaten away by noise and sometimes sliced by a torn plane, with red muscle fibres, fat marbling and silverskin), bones
// (a long bone with a knobbed joint end, a shaft snapped at both ends, a curved rib or a flat shard, each with a jagged break
// that splinters round a hollow marrow cavity, and on some a rag of red meat still clinging), a kidney (a bean with a hilum
// and the stubs of its vessels), a liver lobe (a lobed wedge with a sharp thin edge and torn faces), a heart (a leaning cone
// with a groove, a cap of fat and the cut tubes of its great vessels), a lung lobe, a loop of intestine and an eyeball with
// its stump of nerve. A pixel finds which slot's bounding sphere the view ray enters first (a short test per slot), copies
// that slot's four vec4 into globals and marches it once, so the long code is never expanded per slot. The hit is lit with a
// key light from above, a camera-relative fill, wrap lighting with a red subsurface term, a thin wet film (a broad, weak,
// patchy sheen, not a glassy glint) that fades as the gib dries and darkens (p_clock against the gib's birth), fresnel
// reflection, ambient taken from the scene around the pixel and ambient occlusion from the field itself, with dark clotted
// blood gathering in the crevices. Pixels that miss but sit close to a gib get a contact shadow, a cast shadow and a smear of
// blood. Nothing is written over the scene except where a gib is in front of the scene's depth. A gib near the camera is
// faded out (fully gone within 25 units, whole at 60), one that would fill much of the screen likewise, and while the camera
// is in the aim view close to the active worm (p_aim) the ones around it are hidden so that they never block the aim.
//
// Per slot k (0..15), all hidden and set by Bloodsand: gka = bounding sphere (centre xyz, radius; radius 0 = slot unused),
// gkb = orientation as a unit quaternion (x, y, z, w) of local space to world, gkc = half extents in local space (xyz) and
// the type (w: 0 meat, 1 bone, 2 kidney, 3 liver lobe, 4 heart, 5 eye, 6 lung, 7 intestine), gkd = seed, birth (p_clock when
// it was thrown), starting wetness 0..1 and bloodiness 0..1. Everything is in world units. p_count is one more than the
// highest slot in use (nothing runs at 0), p_clock is Bloodsand's own clock and p_dryTime the seconds a gib takes to dry.
// p_aim is (x, y, z of the active worm, 1) while the camera is in the aim view, else zeros.
//
// The loops below have constant bounds and the field is called from one place per stage (march, normal, occlusion, shadow,
// contact), so the compiler has to expand it only a handful of times.
uniform sampler2D mg_scene;
uniform sampler2D mg_depth;
uniform mat4 mg_invProj;
uniform mat4 mg_proj;
uniform mat4 mg_view;
uniform vec4 mg_resolution;
//@UNIFORMS@
uniform vec3 p_blood;
uniform vec4 p_aim;
uniform float p_strength;
uniform float p_clock;
uniform float p_count;
uniform float p_dryTime;
varying vec2 mg_uv;

const float RECV = 2.6;         // how far beyond a gib's own sphere its bounding sphere reaches: what it darkens and stains

// The gib of the slot this pixel belongs to.
vec3 GC;                        // centre
mat3 GM;                        // local to world
vec4 GH;                        // half extents, type
vec4 GD;                        // seed, birth, wetness, bloodiness
float GB;                       // bounding radius
vec3 GN1;                       // a meat chunk's two tear planes' normals, or a bone's two break planes' (made once per pixel by Load)
vec3 GN2;
vec4 GF;                        // whether the first and second tear are there, whether the bone has a knob, the zigzag's frequency
vec4 GG;                        // a bone's kind (0 long bone, 1 snapped shaft, 2 rib, 3 shard), how much meat clings, where, and a coin

float Hash3(vec3 p) {
    return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
}

float Noise3(vec3 p) {
    vec3 i = floor(p);
    vec3 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = mix(Hash3(i), Hash3(i + vec3(1.0, 0.0, 0.0)), f.x);
    float b = mix(Hash3(i + vec3(0.0, 1.0, 0.0)), Hash3(i + vec3(1.0, 1.0, 0.0)), f.x);
    float c = mix(Hash3(i + vec3(0.0, 0.0, 1.0)), Hash3(i + vec3(1.0, 0.0, 1.0)), f.x);
    float d = mix(Hash3(i + vec3(0.0, 1.0, 1.0)), Hash3(i + vec3(1.0, 1.0, 1.0)), f.x);
    return mix(mix(a, b, f.y), mix(c, d, f.y), f.z);
}

mat3 QuatMat(vec4 q) {
    float xx = q.x * q.x;
    float yy = q.y * q.y;
    float zz = q.z * q.z;
    float xy = q.x * q.y;
    float xz = q.x * q.z;
    float yz = q.y * q.z;
    float wx = q.w * q.x;
    float wy = q.w * q.y;
    float wz = q.w * q.z;
    return mat3(1.0 - 2.0 * (yy + zz), 2.0 * (xy + wz), 2.0 * (xz - wy),
                2.0 * (xy - wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz + wx),
                2.0 * (xz + wy), 2.0 * (yz - wx), 1.0 - 2.0 * (xx + yy));
}

// How dry the current gib is (0 just thrown, 1 dried out) and how wet (its starting wetness, gone as it dries).
float Dry() {
    float d = clamp(max(p_clock - GD.y, 0.0) / max(p_dryTime, 1.0), 0.0, 1.0);
    return d * d * (3.0 - 2.0 * d);
}

// A direction picked by the seed: the normal of a tear plane through a meat chunk.
vec3 CutN(float sd, float j) {
    return normalize(vec3(sin(sd * 12.9 + j * 4.1), cos(sd * 7.3 + j * 2.2) * 0.6, sin(sd * 5.1 + j * 7.7)));
}

float SdBox(vec3 p, vec3 b) {
    vec3 q = abs(p) - b;
    return length(max(q, 0.0)) + min(max(q.x, max(q.y, q.z)), 0.0);
}

float SdEllipsoid(vec3 p, vec3 r) {
    float k0 = length(p / r);
    float k1 = length(p / (r * r));
    return k0 * (k0 - 1.0) / max(k1, 1e-4);
}

float SdCapsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a;
    vec3 ba = b - a;
    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-5), 0.0, 1.0);
    return length(pa - ba * h) - r;
}

// A cut tube from a (inside the body) to b, its radius going from r0 to r1, hollow for `depth` at the b end with a bore of rin:
// a vessel or a bronchus whose end has been torn off.
float SdTube(vec3 p, vec3 a, vec3 b, float r0, float r1, float rin, float depth) {
    vec3 ba = b - a;
    float L = length(ba);
    vec3 ax = ba / L;
    vec3 pa = p - a;
    float t = dot(pa, ax);
    // (far from the tube a capsule round it, which is cheaper and never farther than the tube, stands in for it)
    float dcap = length(pa - ax * clamp(t, 0.0, L)) - max(r0, r1) * 1.25;
    if (dcap > 0.5) return dcap;
    float rad = length(pa - ax * t);
    float te = t - L + 0.6 * dot(pa - ax * t, normalize(cross(ax, vec3(0.31, 0.9, 0.3))));
    float d = max(rad - mix(r0, r1, clamp(t / L, 0.0, 1.0)), max(-t, te));
    return max(d, -max(rad - rin, -depth - te));
}

float SMin(float a, float b, float k) {
    float h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0);
    return mix(b, a, h) - k * h * (1.0 - h);
}

float SMax(float a, float b, float k) {
    return -SMin(-a, -b, k);
}

// A bone's shaft radius at u (-1 at one end to 1 at the other): a long bone narrows a little in the middle and flares to its joint,
// a snapped shaft flares at both ends, a rib narrows along its length and a shard comes to a point.
float BoneR(float u) {
    vec3 h = GH.xyz;
    float v = GG.x;
    float r0 = 0.36 * (h.y + h.z);
    float r = r0 * (1.1 - 0.2 * (1.0 - u * u));
    if (v < 0.5) r += r0 * 0.55 * (1.0 - smoothstep(-0.95, -0.3, u));
    else if (v < 1.5) r += r0 * 0.35 * smoothstep(0.45, 1.0, abs(u));
    else if (v < 2.5) r = r0 * 1.05 * (1.0 - 0.3 * (u * 0.5 + 0.5));
    else r = r0 * 1.2 * (1.0 - 0.88 * smoothstep(-0.8, 1.0, u));
    return r;
}

// A bone's break at one end (sg 1 at +x, -1 at -x): an oblique plane (normal N) pushed out by teeth round the shaft, so that the end
// splinters into spikes of different lengths. Conservative, as the teeth are steep.
float BreakEnd(vec3 q, float ang, float sg, vec3 N, float r0) {
    float kT = GF.w + 1.0;
    float f = ang * 0.159155 * kT + GD.x;
    float id = floor(f);
    id -= kT * floor(id / kT);
    float tri = 1.0 - abs(2.0 * fract(f) - 1.0);
    float amp = (0.35 + 0.65 * Hash3(vec3(id, GD.x, 3.0))) * 4.6 * r0;
    return 0.3 * (dot(vec3(q.x * sg - GH.x * 0.74, q.y, q.z), N) - amp * tri * tri);
}

// The distance to the gib in its own frame. One body of code for all kinds, picked by the type, so the compiler sees it
// once. The sizes come from the half extents: a meat chunk is a rounded box, a bone's x is half its length and y and z the
// radii of its two ends, an organ an ellipsoid with the additions of its kind, an eye a sphere of radius x.
float Shape(vec3 p) {
    vec3 h = GH.xyz;
    float ty = GH.w;
    float sd = GD.x;
    float mn = min(h.x, min(h.y, h.z));
    float d = 1e5;
    if (ty < 0.5) {
        // Meat: a box with its corners rounded, eaten by two octaves of noise and sliced by up to two ragged planes (cuts and
        // tears), so it comes out as an irregular angular chunk.
        float rr = mn * 0.28;
        // (bent and pinched a little first, so that it is not a cube, and part ellipsoid, so that its corners are not sharp)
        vec3 q = p;
        q.xz += 0.3 * mn * vec2(sin(p.y / mn * 1.2 + sd), cos(p.z / mn * 1.1 + sd * 1.7));
        q.y *= 1.0 + 0.25 * sin(p.x / h.x * 1.5 + sd * 2.0);
        d = mix(SdBox(q, max(h - rr, vec3(0.05))) - rr, SdEllipsoid(q, h * 0.98), 0.35);
        float k = 1.3 / mn;
        float n1 = Noise3(p * k + sd);
        float n2 = Noise3(p * k * 2.9 + sd * 1.9);
        d += (n1 - 0.5) * mn * 0.7 + (n2 - 0.5) * mn * 0.2;
        if (GF.x > 0.5) d = SMax(d, dot(p, GN1) - 0.58 * dot(abs(GN1), h) + (n2 - 0.5) * mn * 0.35, mn * 0.1);
        if (GF.y > 0.5) d = SMax(d, dot(p, GN2) - 0.72 * dot(abs(GN2), h) + (n1 - 0.5) * mn * 0.4, mn * 0.1);
    } else if (ty < 1.5) {
        // Bone: see BoneR and BreakEnd. A shaft (a capsule of varying radius, flattened for a rib or a shard, bowed a little), a
        // knob or two condyles at the joint end of a long bone, the break(s) with the marrow bored out of them, a roughness and
        // a rag of meat clinging to some.
        float L = h.x;
        float v = GG.x;
        float r0 = 0.36 * (h.y + h.z);
        float u = clamp(p.x / L, -1.0, 1.0);
        bool thin = v > 1.5;
        vec3 q = p;
        q.y -= (v > 1.5 && v < 2.5 ? 0.2 : 0.035) * L * (1.0 - u * u);
        vec2 cq = vec2(q.y * (thin ? 0.62 : 1.0), q.z * (thin ? (v < 2.5 ? 2.4 : 1.8) : 1.0));
        float lo = (v < 0.5 || v > 1.5 && v < 2.5) ? L : 1.3 * L;
        float hi = v < 2.5 ? 1.3 * L : L;
        float xc = clamp(p.x, -lo, hi);
        float r = BoneR(clamp(xc / L, -1.0, 1.0));
        d = length(vec3(p.x - xc, cq)) - r;
        float n = Noise3(p * (1.5 / r0) + sd);
        if (v < 0.5) {
            // the joint: two condyles with a notch between, or a ball on a neck with a lump beside it
            float rk = r0 * 1.5;
            vec3 c = vec3(-L * 0.93, 0.0, 0.0);
            if (GG.w < 0.5) {
                d = SMin(d, length((q - c - vec3(0.0, 0.62 * rk, 0.0)) * vec3(1.0, 1.0, 1.25)) - rk * 0.72, rk * 0.3);
                d = SMin(d, length((q - c + vec3(0.0, 0.62 * rk, 0.0)) * vec3(1.0, 1.0, 1.25)) - rk * 0.72, rk * 0.3);
                d = SMin(d, length(q - c - vec3(0.6 * rk, 0.0, 0.0)) - rk * 0.42, rk * 0.3);
            } else {
                d = SMin(d, length(q - c - vec3(-0.1 * rk, 0.75 * rk, 0.0)) - rk, rk * 0.4);
                d = SMin(d, length(q - c + vec3(-0.2 * rk, 0.85 * rk, 0.0)) - rk * 0.62, rk * 0.4);
            }
        } else if (v < 2.5 && v > 1.5) {
            d = SMin(d, length(vec3(q.x + L * 0.95, q.y, q.z * 1.6)) - r0 * 1.35, r0 * 0.5);
        }
        d += (n - 0.5) * r0 * 0.14;
        // the breaks, and the marrow bored out of them
        if (abs(p.x) > L * 0.74 - 3.2 * r0) {
            float ang = atan(q.z + 1e-5, q.y);
            float rad = length(cq);
            float xb = p.x;
            if (v < 2.5) d = max(d, BreakEnd(q, ang, 1.0, GN1, r0));
            if (v > 0.5 && v < 1.5 || v > 2.5) d = max(d, BreakEnd(q, ang, -1.0, GN2, r0));
            if (v > 0.5 && v < 1.5) xb = abs(p.x);
            else if (v > 2.5) xb = -p.x;
            d = max(d, -max(rad - 0.42 * r, L * 0.74 - 2.4 * r0 - xb));
        }
        if (GG.y > 0.0) {
            float sl = L * (0.2 + 0.25 * GG.y);
            float rr = r0 * (1.5 + 0.7 * GG.y);
            float ds = SdEllipsoid(vec3(p.x - GG.z * L, q.y, q.z), vec3(sl, rr, rr * 0.8)) + (Noise3(p * (0.75 / r0) + sd * 2.3) - 0.5) * rr * 0.8 + (n - 0.5) * rr * 0.2;
            d = SMin(d, ds, r0 * 0.8);
        }
    } else if (ty < 2.5) {
        // Kidney: a bean (an ellipsoid bent round the hilum), a notch in its concave side where the vessels go in and out, a
        // fatty lump or two in the notch and the cut stubs of the renal vein and artery and the ureter.
        vec3 q = p;
        q.z -= 0.44 * h.z * (p.x / h.x) * (p.x / h.x);
        d = SdEllipsoid(q, h * vec3(1.0, 1.0, 0.92));
        float n = Noise3(p * (1.3 / mn) + sd);
        d = SMax(d, -SdEllipsoid(p - vec3(0.04 * h.x, 0.0, 1.0 * h.z), vec3(0.36 * h.x, 0.95 * h.y, 0.66 * h.z)), 0.24 * h.z);
        d += (n - 0.5) * mn * 0.1;
        d = SMin(d, SdEllipsoid(p - vec3(-0.12 * h.x, -0.45 * h.y, 0.8 * h.z), h * vec3(0.2, 0.3, 0.28)) + (n - 0.5) * mn * 0.15, mn * 0.2);
        d = SMin(d, SdTube(p, vec3(0.0, 0.12 * h.y, 0.45 * h.z), vec3(0.3 * h.x, 0.2 * h.y, 1.75 * h.z), h.z * 0.21, h.z * 0.17, h.z * 0.1, h.z * 0.6), 0.14 * h.z);
        d = SMin(d, SdTube(p, vec3(-0.1 * h.x, -0.2 * h.y, 0.45 * h.z), vec3(-0.4 * h.x, -0.25 * h.y, 1.5 * h.z), h.z * 0.12, h.z * 0.1, h.z * 0.045, h.z * 0.5), 0.1 * h.z);
        d = SMin(d, SdTube(p, vec3(0.0, -0.45 * h.y, 0.45 * h.z), vec3(0.2 * h.x, -0.6 * h.y, 1.4 * h.z), h.z * 0.1, h.z * 0.09, h.z * 0.045, h.z * 0.5), 0.1 * h.z);
        if (GF.x > 0.5) d = SMax(d, dot(p, GN1) - 0.5 * dot(abs(GN1), h) + (Noise3(p * (2.4 / mn) + sd * 1.9) - 0.5) * mn * 0.3, mn * 0.08);
    } else if (ty < 3.5) {
        // Liver: a slab with a lobed outline (a big blunt right lobe and a small left one, a cleft between them), thick at the
        // right lobe's end and thinning to a sharp edge at the left, arched on top and flatter beneath, ragged at the rim, and
        // sometimes sliced by a torn plane.
        float nL = Noise3(p * (0.9 / mn) + sd);
        float dA = (length(vec2(p.x + 0.22 * h.x, p.z) / vec2(0.78 * h.x, 0.92 * h.z)) - 1.0) * 0.8 * h.z;
        float dB = (length(vec2(p.x - 0.58 * h.x, p.z + 0.14 * h.z) / vec2(0.46 * h.x, 0.5 * h.z)) - 1.0) * 0.46 * h.z;
        float dO = SMin(dA, dB, 0.3 * h.z) + (nL - 0.5) * 0.3 * h.z;
        dO = SMax(dO, -(length(vec2(p.x - 0.3 * h.x, p.z - 0.62 * h.z)) - 0.2 * h.z), 0.12 * h.z);
        float u = clamp(p.x / h.x, -1.0, 1.0);
        float edge = h.y * mix(0.45, 0.05, smoothstep(-0.3, 0.9, u));
        float mid = h.y * mix(1.0, 0.4, smoothstep(-0.4, 1.0, u));
        float T = edge + (mid - edge) * (1.0 - exp(-max(-dO, 0.0) * 1.1 / h.y));
        float dY = abs(p.y - 0.2 * T) - T;
        d = SMax(dO, dY, 0.25 * edge + 0.03);
        d += (nL - 0.5) * h.y * 0.12;
        d = SMax(d, -(length(vec2(p.x - 0.1 * h.x, p.y + 1.1 * h.y)) - 0.5 * h.y), 0.2 * h.y);
        d = SMin(d, SdTube(p, vec3(0.3 * h.x, 0.0, 0.3 * h.z), vec3(0.4 * h.x, 0.1 * h.y, 1.2 * h.z), h.y * 0.34, h.y * 0.28, h.y * 0.16, h.y * 0.9), 0.2 * h.y);
        if (GF.x > 0.5) d = SMax(d, dot(p, GN1) - 0.5 * dot(abs(GN1), h) + (Noise3(p * (2.4 / mn) + sd * 1.9) - 0.5) * mn * 0.35, mn * 0.08);
    } else if (ty < 4.5) {
        // Heart: a cone leaning to its apex at -y, a flatter right ventricle in front of it, a groove between, the two auricles
        // on top under a cap of lumpy fat, and the cut tubes of the aorta, the pulmonary artery and the vena cava.
        float yy = p.y / h.y;
        float n = Noise3(p * (1.4 / mn) + sd);
        vec3 q = p;
        q.x -= 0.26 * h.x * clamp(-yy, 0.0, 1.2);
        float s = mix(0.34, 1.0, smoothstep(-1.0, 0.4, yy));
        d = SdEllipsoid(vec3(q.x / s, p.y, q.z / s), h * vec3(0.88, 1.0, 0.8)) * s;
        float dR = SdEllipsoid(vec3(q.x + 0.5 * h.x, p.y * 1.1 + 0.12 * h.y, q.z - 0.3 * h.z), h * vec3(0.5, 0.86, 0.6));
        d = SMin(d, dR, 0.22 * h.x);
        d = SMax(d, -SdCapsule(p, vec3(-0.15 * h.x, 0.75 * h.y, 0.9 * h.z), vec3(0.3 * h.x, -0.7 * h.y, 0.55 * h.z), 0.09 * h.x), 0.1 * h.x);
        d = SMin(d, SdEllipsoid(p - vec3(-0.55 * h.x, 0.82 * h.y, 0.3 * h.z), h * vec3(0.38, 0.28, 0.3)), 0.14 * h.x);
        d = SMin(d, SdEllipsoid(p - vec3(0.5 * h.x, 0.8 * h.y, 0.45 * h.z), h * vec3(0.3, 0.26, 0.28)), 0.14 * h.x);
        d += (n - 0.5) * mn * 0.14 + smoothstep(0.2, 0.9, yy) * (n - 0.35) * mn * 0.26;
        d = SMin(d, SdTube(p, vec3(0.12 * h.x, 0.7 * h.y, -0.05 * h.z), vec3(0.18 * h.x, 1.35 * h.y, -0.05 * h.z), h.x * 0.3, h.x * 0.27, h.x * 0.17, h.y * 0.45), 0.16 * h.x);
        d = SMin(d, SdTube(p, vec3(0.2 * h.x, 1.25 * h.y, -0.05 * h.z), vec3(0.7 * h.x, 1.6 * h.y, -0.2 * h.z), h.x * 0.27, h.x * 0.25, h.x * 0.16, h.y * 0.4), 0.12 * h.x);
        d = SMin(d, SdTube(p, vec3(-0.22 * h.x, 0.65 * h.y, 0.4 * h.z), vec3(-0.42 * h.x, 1.4 * h.y, 0.5 * h.z), h.x * 0.25, h.x * 0.23, h.x * 0.15, h.y * 0.4), 0.14 * h.x);
        d = SMin(d, SdTube(p, vec3(-0.65 * h.x, 0.6 * h.y, -0.15 * h.z), vec3(-0.85 * h.x, 1.3 * h.y, -0.25 * h.z), h.x * 0.27, h.x * 0.25, h.x * 0.17, h.y * 0.35), 0.14 * h.x);
    } else if (ty < 5.5) {
        // Eye: the globe, the bulge of the cornea and a stump of nerve.
        d = length(p) - h.x;
        d = SMin(d, length(p - vec3(h.x * 0.5, 0.0, 0.0)) - h.x * 0.58, h.x * 0.25);
        d = SMin(d, SdCapsule(p, vec3(-h.x * 0.8, 0.0, 0.0), vec3(-h.x * 1.7, h.x * 0.25, h.x * 0.1), h.x * 0.24), h.x * 0.25);
    } else if (ty < 6.5) {
        // Lung: a lobe, thick at one end and thinning to a blunt edge at the other, a smaller lobe under it with a fissure
        // between, ragged where it was torn out and the cut stub of the bronchus on its inner side.
        float n = Noise3(p * (1.1 / mn) + sd);
        float zs = mix(1.0, 0.5, smoothstep(-1.0, 1.0, p.x / h.x));
        d = SdEllipsoid(vec3(p.x, p.y, p.z / zs), h * vec3(0.95, 1.0, 1.0)) * zs;
        float d2 = SdEllipsoid(p - vec3(-0.3 * h.x, -0.5 * h.y, 0.2 * h.z), h * vec3(0.66, 0.62, 0.8));
        d = SMin(d, d2, 0.12 * h.z);
        d = SMax(d, -SdCapsule(p, vec3(-0.9 * h.x, 0.45 * h.y, 0.9 * h.z), vec3(0.5 * h.x, -0.1 * h.y, 0.8 * h.z), 0.2 * h.z), 0.15 * h.z);
        d += (n - 0.5) * mn * 0.3;
        d = SMin(d, SdTube(p, vec3(0.1 * h.x, 0.4 * h.y, 0.05 * h.z), vec3(0.32 * h.x, 1.5 * h.y, 0.1 * h.z), h.z * 0.24, h.z * 0.2, h.z * 0.11, h.z * 0.8), 0.12 * h.z);
        d = SMin(d, SdTube(p, vec3(0.0, 0.3 * h.y, -0.1 * h.z), vec3(-0.28 * h.x, 1.35 * h.y, -0.05 * h.z), h.z * 0.19, h.z * 0.16, h.z * 0.09, h.z * 0.7), 0.12 * h.z);
        if (GF.x > 0.5) d = SMax(d, dot(p, GN1) - 0.6 * dot(abs(GN1), h) + (Noise3(p * (2.2 / mn) + sd * 1.9) - 0.5) * mn * 0.4, mn * 0.1);
    } else {
        // Intestine: a loop of gut, a C of tube slightly tilted so that its two cut ends lie at different heights, its radius
        // swelling and narrowing along the way, each end open on a dark bore.
        float r = h.y * 0.74;
        float R = h.x - r * 1.1;
        vec3 q = vec3(p.x, p.y * 0.98 - p.z * 0.2, p.z * 0.98 + p.y * 0.2);
        vec3 t = vec3(abs(q.x), q.z, q.y);
        vec2 sc = vec2(0.598, -0.801);
        float k = (sc.y * t.x > sc.x * t.y) ? dot(t.xy, sc) : length(t.xy);
        float rr = r * (1.0 + 0.1 * cos(atan(t.x, t.y) * 9.0 + sd));
        float dist = sqrt(max(dot(t, t) + R * R - 2.0 * R * k, 0.0));
        d = dist - rr;
        float dn = dot(t.xy, vec2(sc.y, -sc.x));
        d = max(d, dn);
        d = max(d, -max(dist - rr * 0.55, -dn - 0.9));
        d += (Noise3(p * (1.6 / r) + sd) - 0.5) * r * 0.16;
    }
    return d * 0.72;
}

// The distance to the gib of the current slot, in world space.
float Map(vec3 pw) {
    return Shape((pw - GC) * GM);
}

// Half extents of a box (in the gib's frame) that holds the whole of it, what sticks out of a plain rounded box included (a bone's
// knob and bow, a kidney's vessels, a heart's great vessels, an eye's nerve, a lung's bronchus).
vec3 BoxExt() {
    vec3 h = GH.xyz;
    float ty = GH.w;
    if (ty < 0.5) return h * 1.15 + 0.6;
    if (ty < 1.5) return vec3(max(h.x + 1.5 * h.y + 0.5, 0.74 * h.x + 1.8 * (h.y + h.z) + 0.5), 0.2 * h.x + 1.5 * h.y + 0.8, 1.5 * h.y + 0.5);
    if (ty < 2.5) return vec3(h.x * 1.1 + 0.5, h.y * 1.1 + 0.5, h.z * 1.9 + 0.5);
    if (ty < 3.5) return h * 1.15 + 0.5;
    if (ty < 4.5) return vec3(h.x * 1.3 + 0.5, h.y * 1.75 + 0.5, h.z * 1.2 + 0.5);
    if (ty < 5.5) return vec3(h.x * 1.8 + 0.5, h.x * 1.2 + 0.3, h.x * 1.2 + 0.3);
    if (ty < 6.5) return vec3(h.x * 1.1 + 0.5, h.y * 1.6 + 0.5, h.z * 1.1 + 0.5);
    return vec3(h.x * 1.1 + 0.5, h.y * 1.4 + 0.9, h.z * 1.1 + 0.5);
}

// A cheap stand-in for the gib, an ellipsoid of its extents: what darkens and stains the ground around it is judged against this, so
// that the pixels of a bounding sphere that miss the gib do not pay for the real field.
float Proxy(vec3 pw) {
    return SdEllipsoid((pw - GC) * GM, GH.xyz * (GH.w < 1.5 && GH.w > 0.5 ? vec3(1.0, 1.3, 1.3) : vec3(0.9)));
}

// Copies slot sel's four vec4 out of the uniforms and builds the frame.
void Load(float sel) {
    vec4 A = vec4(0.0);
    vec4 B = vec4(0.0, 0.0, 0.0, 1.0);
//@LOAD@
    GC = A.xyz;
    GB = A.w;
    GM = QuatMat(B);
    // What Shape needs of the seed, once here and not at every step of the march.
    float sd = GD.x;
    GN1 = CutN(sd, 0.0);
    GN2 = CutN(sd, 1.0);
    GF = vec4(Hash3(vec3(sd, 3.0, 7.0)) > 0.3 ? 1.0 : 0.0, Hash3(vec3(sd, 8.0, 1.0)) > 0.35 ? 1.0 : 0.0,
              Hash3(vec3(sd, 11.0, 2.0)) > 0.45 ? 1.0 : 0.0, 2.0 + floor(Hash3(vec3(sd, 5.0, 1.0)) * 3.0));
    GG = vec4(0.0);
    if (GH.w > 0.5 && GH.w < 1.5) {
        float v = Hash3(vec3(sd, 2.0, 9.0));
        GG.x = v < 0.4 ? 0.0 : (v < 0.65 ? 1.0 : (v < 0.85 ? 2.0 : 3.0));
        GG.y = Hash3(vec3(sd, 4.0, 6.0)) < 0.65 ? 0.3 + 0.7 * Hash3(vec3(sd, 6.0, 1.0)) : 0.0;
        GG.z = mix(-0.65, 0.3, Hash3(vec3(sd, 7.0, 3.0)));
        GG.w = Hash3(vec3(sd, 12.0, 5.0));
        GN1 = normalize(vec3(1.0, 0.8 * sin(sd * 3.1), 0.8 * cos(sd * 5.7)));
        GN2 = normalize(vec3(1.0, 0.8 * sin(sd * 7.3), 0.8 * cos(sd * 2.9)));
    }
}

// How much of the current gib is left after it is faded for being near the camera (whole at 60 units, gone at 25), for being big
// on the screen, and, while the camera is in the aim view (p_aim), for being near the camera or the active worm there. The size
// is what a ball of the gib's mean size takes of half the screen's height (the projection's own scale, so a zoomed camera, as
// the aim view's is, counts as nearer): a gib that would cover more than about a third of the screen's height is gone whatever
// its distance, and in the aim view one of an eighth already, so nothing big ever sits in front of the aim. The size ramps are
// short, so a gib is half see-through only for a moment as the camera passes it.
float Fade(vec3 camW) {
    float dc = length(GC - camW);
    float f = smoothstep(25.0, 60.0, dc);
    float s0 = 0.2;
    if (p_aim.w > 0.5) {
        f = min(f, smoothstep(50.0, 90.0, dc));
        f = min(f, smoothstep(26.0, 52.0, length(GC - p_aim.xyz)));
        s0 = 0.08;
    }
    float rm = pow(GH.x * GH.y * GH.z, 0.3333) * 1.35;
    return f * (1.0 - smoothstep(s0, s0 * 1.5, rm * mg_proj[1][1] / max(dc, 1.0)));
}

// Tests the view ray against slot k's bounding sphere and keeps the three spheres that are entered first, each as
// (where the ray enters, where it leaves, the slot): f is the first, g the second and h the third. Where spheres overlap the ray
// may reach any of them, so main() looks into all three.
void Bound(vec4 s, float k, vec3 ro, vec3 rd, inout vec3 f, inout vec3 g, inout vec3 e) {
    if (s.w <= 0.0) return;
    vec3 oc = ro - s.xyz;
    float b = dot(oc, rd);
    float q = b * b - (dot(oc, oc) - s.w * s.w);
    if (q < 0.0) return;
    q = sqrt(q);
    float t0 = -b - q;
    float t1 = -b + q;
    if (t1 < 0.0) return;
    if (t0 < f.x) {
        e = g;
        g = f;
        f = vec3(t0, t1, k);
    } else if (t0 < g.x) {
        e = g;
        g = vec3(t0, t1, k);
    } else if (t0 < e.x) {
        e = vec3(t0, t1, k);
    }
}

void main() {
    vec4 scene = texture2D(mg_scene, mg_uv);
    gl_FragColor = scene;
    if (p_strength <= 0.0 || p_count < 0.5) return;

    // The view ray in world space.
    vec4 pf = mg_invProj * vec4(mg_uv * 2.0 - 1.0, 0.0, 1.0);
    vec3 dirW = normalize(pf.xyz / pf.w) * mat3(mg_view);
    vec3 camW = -(mg_view[3].xyz * mat3(mg_view));

    // The two bounding spheres the ray enters first. Most pixels meet none, and leave here, before the depth is read.
    float tScene = 1e5;
    vec3 sph0 = vec3(1e5, 0.0, -1.0);
    vec3 sph1 = vec3(1e5, 0.0, -1.0);
    vec3 sph2 = vec3(1e5, 0.0, -1.0);
//@BOUNDS@
    if (sph0.z < 0.0) return;
    float depth = texture2D(mg_depth, mg_uv).r;
    if (depth < 1.0) {
        vec4 vp = mg_invProj * vec4(vec3(mg_uv, depth) * 2.0 - 1.0, 1.0);
        tScene = length(vp.xyz / vp.w);
    }
    // (a sphere that begins behind what the scene shows is of no use, and the spheres are in the order they begin in)
    if (sph0.x > tScene + 1.0) return;
    if (sph1.x > tScene + 1.0) sph1.z = -1.0;
    if (sph2.x > tScene + 1.0) sph2.z = -1.0;

    // Up to three slots are looked into, the first sphere the ray enters and the next two (only where spheres overlap), by
    // the same code in a loop, so the long code is expanded once. The nearer gib wins.
    float pix = 2.0 / (mg_proj[1][1] * mg_resolution.y);
    float bSel = -1.0;      // the slot of the best candidate so far, and what it found
    float bCover = 0.0;
    float bT = 0.0;
    float bD = 1e5;
    float bF = 1.0;         // how much of it is left after the fade
    float loaded = -1.0;    // the slot whose gib is in the globals
    // What a gib does to the ground next to it, kept over the (up to three) gibs the ray looks into: how much it darkens it and
    // how much blood it smears there.
    vec3 Pw = camW + dirW * tScene;
    vec3 tint = p_blood / max(max(p_blood.r, p_blood.g), max(p_blood.b, 1e-3));
    vec3 Lk = normalize(vec3(0.35, 0.85, 0.25));
    float darkAcc = 0.0;
    float smearAcc = 0.0;
    for (int pass = 0; pass < 3; pass++) {
        vec3 sph = pass == 0 ? sph0 : (pass == 1 ? sph1 : sph2);
        if (sph.z < 0.0) break;
        // (the spheres come in the order the ray enters them: once a gib is hit solidly nearer than where the next sphere begins,
        // nothing in it can be in front, and what it would do to the ground is hidden under the gib)
        if (bCover >= 1.0 && sph.x > bT) break;
        Load(sph.z);
        loaded = sph.z;
        float gf = Fade(camW);
        if (gf < 0.004) continue;
        float fade = depth < 1.0 ? 1.0 - smoothstep(GB - 3.2, GB - 0.4, length(Pw - GC)) : 0.0;
        if (fade > 0.01) {
            float dg = Proxy(Pw + Lk * 0.8);
            float contact = exp(-max(dg, 0.0) * 0.9);
            float castSh = 1.0 - smoothstep(0.0, 2.4, Proxy(Pw + Lk * 2.4));
            float dk = fade * gf * (0.45 * contact + 0.27 * castSh * (1.0 - contact));
            darkAcc = 1.0 - (1.0 - darkAcc) * (1.0 - dk);
            smearAcc = max(smearAcc, (1.0 - smoothstep(0.1, 1.2, dg)) * GD.w * fade * gf * (0.5 + 0.5 * (1.0 - Dry())));
        }
        // March from where the ray enters the sphere. A step is the distance (the field is already scaled down, see Shape), and a hit is
        // within a third of a pixel; a ray that gets within a pixel of a gib without touching it keeps that closest point
        // for the soft edge.
        // (only a ray that meets a box that holds the gib is marched, from where it enters it to where it leaves: the bounding
        // sphere is wider by what the contact shadow needs and round, which most of the pixels in it do not need.)
        vec3 bo = (camW - GC) * GM;
        vec3 bd = dirW * GM;
        vec3 bx = BoxExt();
        vec3 bi = 1.0 / (abs(bd) + 1e-6) * sign(bd + 1e-9);
        vec3 b1 = -bi * bo - abs(bi) * bx;
        vec3 b2 = -bi * bo + abs(bi) * bx;
        float tN = max(max(b1.x, b1.y), max(b1.z, 0.0));
        float tF = min(min(b2.x, b2.y), b2.z);
        float t = tN;
        float tEnd = tF > tN ? min(tF, tScene + 0.5) : -1.0;
        float tBest = t;
        float dBest = 1e5;
        float hit = 0.0;
        for (int i = 0; i < 20; i++) {
            if (t > tEnd) break;
            float d = Map(camW + dirW * t);
            if (d < dBest) {
                dBest = d;
                tBest = t;
            }
            if (d < 0.33 * pix * t + 0.004) {
                hit = 1.0;
                break;
            }
            t += d;
            if (t > tEnd) break;
        }
        // A ray that used up its steps still inside the box and close to the surface is on it: near the camera a gib is hundreds
        // of pixels across, the hit test asks for a third of a pixel, and the steps run out first, which used to leave rings of
        // half-covered pixels across the gib.
        if (hit < 0.5 && t <= tEnd && dBest < 0.06) hit = 1.0;
        float cov = hit;
        if (hit < 0.5) cov = 1.0 - smoothstep(0.0, pix * tBest + 1e-4, dBest);
        if (tBest > tScene + 0.4) cov = 0.0;
        if (bSel < 0.0 || (cov > 0.0 && (bCover <= 0.0 || tBest < bT)) || (cov <= 0.0 && bCover <= 0.0 && dBest < bD)) {
            bSel = sph.z;
            bCover = cov;
            bT = tBest;
            bD = dBest;
            bF = gf;
        }
    }
    if (bSel < 0.0) return;
    if (loaded != bSel) Load(bSel);
    float tBest = bT;
    float cover = bCover * bF;

    vec3 lumW = vec3(0.299, 0.587, 0.114);
    float seed = GD.x;
    float dry = Dry();
    float wet = clamp(GD.z, 0.0, 1.0) * (1.0 - dry);

    // Not covered: the gib still darkens the ground it lies on, casts a soft shadow away from the light and stains it.
    vec3 base = scene.rgb * (1.0 - darkAcc);
    base = mix(base, base * tint * 0.55, 0.45 * smearAcc);
    if (cover <= 0.0) {
        gl_FragColor = vec4(mix(scene.rgb, base, p_strength), scene.a);
        return;
    }

    // ---- shading -----------------------------------------------------------------------------------------------
    vec3 p = camW + dirW * tBest;
    vec3 V = -dirW;
    float ty = GH.w;
    vec3 h = GH.xyz;
    float mn = min(h.x, min(h.y, h.z));
    bool isEye = ty > 4.5 && ty < 5.5;

    // The normal from four taps of the field, then a fine bump from noise on the surface only.
    vec3 n = vec3(0.0);
    for (int k = 0; k < 4; k++) {
        vec3 e = vec3((k == 0 || k == 3) ? 1.0 : -1.0, (k == 2 || k == 3) ? 1.0 : -1.0, (k == 1 || k == 3) ? 1.0 : -1.0);
        n += e * Map(p + e * 0.02);
    }
    float nlen = length(n);
    n = nlen > 1e-8 ? n / nlen : vec3(0.0, 1.0, 0.0);
    vec3 pl = (p - GC) * GM;

    // Where it was cut or torn (a plane through the gib with a ragged edge): raw, fibrous, red.
    float raw = 0.0;
    if (ty < 0.5) {
        raw = GF.x > 0.5 ? 1.0 - smoothstep(0.0, 0.3 * mn, abs(dot(pl, GN1) - 0.58 * dot(abs(GN1), h))) : 0.0;
        raw = max(raw, GF.y > 0.5 ? 1.0 - smoothstep(0.0, 0.3 * mn, abs(dot(pl, GN2) - 0.72 * dot(abs(GN2), h))) : 0.0);
    } else if (ty > 1.5 && ty < 3.5 || ty > 5.5 && ty < 6.5) {
        float off = ty > 5.5 ? 0.6 : 0.5;
        raw = GF.x > 0.5 ? 1.0 - smoothstep(0.0, 0.25 * mn, abs(dot(pl, GN1) - off * dot(abs(GN1), h))) : 0.0;
    }

    // How much detail is worth drawing: a gib that is only a few pixels across has no use for a bump, an occlusion or a shadow of
    // its own (0 under 6 pixels across its thinnest, 1 over 14).
    float detail = clamp((mn / (pix * tBest) - 3.0) / 4.0, 0.0, 1.0);
    if (detail > 0.0) {
        float bk = ty < 1.5 ? 3.0 / h.y : 2.6 / mn;
        vec3 q = pl * bk + seed;
        float b0 = Noise3(q);
        vec3 g = vec3(Noise3(q + vec3(0.4, 0.0, 0.0)), Noise3(q + vec3(0.0, 0.4, 0.0)), Noise3(q + vec3(0.0, 0.0, 0.4))) - b0;
        float bump = (ty < 0.5 ? 0.9 : (ty < 1.5 ? 0.5 : (ty > 5.5 && ty < 6.5 ? 0.5 : (ty > 3.5 && ty < 4.5 ? 0.6 : 0.4)))) * detail * (1.0 + 1.2 * raw);
        // a second, finer octave: the grain of the surface, ragged on the raw faces (only on a gib more than 12 pixels across its
        // thinnest, full over 20: smaller, the grain is under a pixel and only costs time)
        vec3 g2 = vec3(0.0);
        float grainK = clamp((mn / (pix * tBest) - 12.0) / 8.0, 0.0, 1.0);
        if (ty > 0.5 && grainK > 0.0) {
            vec3 q2 = pl * bk * 3.3 + seed * 1.7;
            float c0 = Noise3(q2);
            g2 = vec3(Noise3(q2 + vec3(0.4, 0.0, 0.0)), Noise3(q2 + vec3(0.0, 0.4, 0.0)), Noise3(q2 + vec3(0.0, 0.0, 0.4))) - c0;
        }
        vec3 gw = GM * (g + g2 * grainK * (0.35 + 0.6 * raw));          // the bump is made in the local frame and turned into the world's
        n = normalize(n + bump * (gw - dot(gw, n) * n));
    }
    float nv = clamp(dot(n, V), 0.0, 1.0);

    // Ambient occlusion from the field along the normal, darker underneath (where it lies on the ground).
    float ao = 1.0;
    // The key light's shadow on the gib itself: a short march.
    float shade = 1.0;
    if (detail > 0.0) {
        float hk = 0.35 + 0.1 * mn;
        ao = mix(1.0, clamp(1.0 - 1.1 * (hk - Map(p + n * hk)) / max(mn * 0.5, 0.5), 0.0, 1.0), detail);
        // (one step, at the distance the second of two used to reach: the first added little and cost a field evaluation)
        float st = 0.55;
        float hs = Map(p + n * 0.05 + Lk * st);
        shade = min(shade, 6.0 * hs / st);
        shade = mix(1.0, clamp(shade, 0.0, 1.0), detail);
    }
    ao *= mix(0.45, 1.0, clamp(n.y * 0.5 + 0.6, 0.0, 1.0));

    // ---- material: the colour, the gloss and how much light goes through, by kind ---------------------------------------
    vec3 albedo = vec3(0.5, 0.1, 0.1);
    float gloss = 0.5;
    float sssK = 1.0;
    float fine = Noise3(pl * (7.0 / mn) + seed * 2.0);
    float mott = Noise3(pl * (1.1 / mn) + seed * 3.1);
    if (ty < 0.5) {
        // Muscle: dark red with lighter streaks along the fibres (x), fat marbling, silverskin and pale, fibrous tear faces.
        float fib = Noise3(vec3(pl.x * 0.3, pl.y * 4.5, pl.z * 4.5) / mn + seed);
        albedo = mix(vec3(0.2, 0.014, 0.022), vec3(0.5, 0.055, 0.05), clamp(0.15 + 0.75 * fib + 0.5 * (mott - 0.5), 0.0, 1.0));
        // (some chunks are fatty and pale, a few dark and clotted)
        float mv = Hash3(vec3(seed, 13.0, 2.0));
        float fatK = smoothstep(0.78, 0.86, mv);
        albedo *= 1.0 - 0.45 * (1.0 - smoothstep(0.08, 0.16, mv));
        float marb = smoothstep(0.66 - 0.2 * fatK, 0.78 - 0.1 * fatK, Noise3(vec3(pl.x * 0.5, pl.y * 2.2, pl.z * 2.2) / mn * 1.7 + seed * 3.0));
        albedo = mix(albedo, vec3(0.93, 0.80, 0.58), marb * (0.85 + 0.15 * fatK));
        float sil = smoothstep(0.64, 0.8, Noise3(pl * (0.8 / mn) + seed * 5.0));
        albedo = mix(albedo, vec3(0.86, 0.64, 0.6), sil * 0.6);
        albedo = mix(albedo, mix(vec3(0.55, 0.11, 0.1), vec3(0.88, 0.38, 0.32), Noise3(vec3(pl.x * 0.12, pl.y * 9.0, pl.z * 9.0) / mn + seed * 7.0)), raw * 0.75);
        albedo *= 0.9 + 0.2 * fine;
        albedo = mix(albedo, tint * dot(albedo, lumW) * 1.8, 0.2);
        gloss = 0.6;
        sssK = 0.7;
    } else if (ty < 1.5) {
        // Bone: ivory with a yellow tint and brown stains, matte, porous and rough; hollow and marrow-red where it broke, with the
        // pale spongy rim of the break; the bits of flesh that cling are dark red with white sinew.
        float L = h.x;
        float r0 = 0.36 * (h.y + h.z);
        float v = GG.x;
        float u = clamp(pl.x / L, -1.0, 1.0);
        float yb = pl.y - (v > 1.5 && v < 2.5 ? 0.2 : 0.035) * L * (1.0 - u * u);
        float rad = length(vec2(yb * (v > 1.5 ? 0.62 : 1.0), pl.z * (v > 1.5 ? (v < 2.5 ? 2.4 : 1.8) : 1.0)));
        float rb = max(BoneR(u), 1e-3);
        albedo = mix(vec3(0.98, 0.95, 0.85), vec3(0.9, 0.8, 0.58), smoothstep(0.35, 0.8, mott));
        albedo = mix(albedo, vec3(0.6, 0.46, 0.28), 0.22 * smoothstep(0.68, 0.84, Noise3(pl * (0.7 / r0) + seed * 5.0)));
        float pit = smoothstep(0.58, 0.74, Noise3(pl * (6.0 / r0) + seed));
        albedo *= 1.0 - 0.22 * pit;
        albedo *= 0.92 + 0.14 * fine;
        // a thin film of periosteum, pinker, in streaks along the shaft
        albedo = mix(albedo, vec3(0.8, 0.55, 0.5), 0.18 * smoothstep(0.6, 0.8, Noise3(vec3(pl.x * 0.35, pl.y * 3.0, pl.z * 3.0) / r0 + seed * 2.0)));
        // the break: the cut face is pale and spongy, the bore marrow-dark
        float endU = v > 2.5 ? -u : (v > 0.5 && v < 1.5 ? abs(u) : u);
        float ends = smoothstep(0.5, 0.72, endU);
        float inb = 1.0 - smoothstep(0.4, 0.52, rad / rb);
        if (ends > 0.01) {
            float spongy = smoothstep(0.45, 0.7, Noise3(pl * (5.5 / r0) + seed * 3.0));
            albedo = mix(albedo, vec3(0.9, 0.82, 0.62), ends * (1.0 - inb) * 0.4);
            albedo = mix(albedo, mix(vec3(0.38, 0.05, 0.05), vec3(0.62, 0.3, 0.22), spongy), ends * inb);
        }
        // meat clinging: what lies outside the bone's own radius (not the knob)
        float meat = smoothstep(0.1 * rb, 0.3 * rb, rad - rb) * ((v < 0.5 && u < -0.74) ? 0.0 : 1.0) * (GG.y > 0.0 ? 1.0 : 0.0);
        if (meat > 0.01) {
            float sin1 = smoothstep(0.62, 0.78, Noise3(vec3(pl.x * 0.25, pl.y * 3.5, pl.z * 3.5) / r0 + seed * 3.0));
            vec3 mcol = mix(vec3(0.16, 0.014, 0.02), vec3(0.4, 0.045, 0.045), clamp(0.2 + 0.8 * Noise3(vec3(pl.x * 0.3, pl.y * 4.0, pl.z * 4.0) / r0 + seed), 0.0, 1.0));
            mcol = mix(mcol, vec3(0.86, 0.7, 0.62), sin1 * 0.7);
            albedo = mix(albedo, mcol, meat);
        }
        albedo = mix(albedo, p_blood * 1.3, 0.5 * GD.w * smoothstep(0.35, 0.8, Noise3(pl * (1.0 / h.y) + seed * 4.0)) * (1.0 - meat));
        gloss = 0.14 + 0.3 * meat;
        sssK = 0.2 + 0.6 * meat;
    } else if (ty < 2.5) {
        // Kidney: a dark red-brown capsule, a faint web of veins, fine fibres, fat and pale vessels at the notch; cut open, a
        // darker cortex round a lighter medulla.
        albedo = mix(vec3(0.26, 0.05, 0.04), vec3(0.4, 0.085, 0.06), mott);
        float vein = 1.0 - smoothstep(0.0, 0.05, abs(Noise3(pl * (3.0 / mn) + seed * 2.1) - 0.5));
        albedo = mix(albedo, vec3(0.5, 0.1, 0.1), 0.35 * vein);
        albedo *= 0.9 + 0.2 * Noise3(vec3(pl.x * 1.5, pl.y * 12.0, pl.z * 12.0) / mn + seed);
        float notch = smoothstep(0.3, 0.9, pl.z / h.z);
        float fat = smoothstep(0.38, 0.62, Noise3(pl * (2.0 / mn) + seed)) * notch;
        albedo = mix(albedo, vec3(0.86, 0.7, 0.44), fat * 0.85);
        float vess = smoothstep(1.1, 1.35, pl.z / h.z);
        vec3 vcol = pl.y > -0.1 * h.y ? vec3(0.62, 0.5, 0.58) : (pl.y > -0.5 * h.y ? vec3(0.8, 0.58, 0.55) : vec3(0.82, 0.7, 0.5));
        albedo = mix(albedo, vcol, vess);
        float cutr = length(pl / h);
        albedo = mix(albedo, mix(vec3(0.44, 0.12, 0.08), vec3(0.62, 0.22, 0.16), smoothstep(0.55, 0.3, cutr) * (0.6 + 0.4 * fine)), raw * 0.85);
        albedo = mix(albedo, tint * dot(albedo, lumW) * 1.8, 0.15);
        gloss = 0.55;
        sssK = 0.9;
    } else if (ty < 3.5) {
        // Liver: dark maroon-brown, satin, mottled slowly with paler and yellower patches; torn faces are raw and granular.
        float lob = Noise3(pl * (2.2 / mn) + seed * 3.1);
        albedo = mix(vec3(0.17, 0.034, 0.03), vec3(0.34, 0.08, 0.052), clamp(0.6 * mott + 0.5 * lob - 0.12, 0.0, 1.0));
        albedo = mix(albedo, vec3(0.4, 0.19, 0.07), 0.55 * smoothstep(0.6, 0.8, Noise3(pl * (1.4 / mn) + seed * 6.0)));
        albedo *= 0.88 + 0.24 * fine;
        albedo = mix(albedo, mix(vec3(0.3, 0.045, 0.04), vec3(0.58, 0.14, 0.1), fine), raw * 0.85);
        albedo = mix(albedo, tint * dot(albedo, lumW) * 1.8, 0.12);
        gloss = 0.5;
        sssK = 0.6;
    } else if (ty < 4.5) {
        // Heart: dark red muscle with fine fibres, a lumpy cream-yellow cap of fat over the top and along the groove, a web of red
        // vessels in it, and the cut great vessels pale, one of them blue.
        float yy = pl.y / h.y;
        albedo = mix(vec3(0.3, 0.035, 0.04), vec3(0.5, 0.075, 0.07), mott);
        albedo *= 0.75 + 0.5 * Noise3(vec3(pl.x * 8.0, pl.y * 1.5, pl.z * 8.0) / mn + seed);
        float grv = SdCapsule(pl, vec3(-0.15 * h.x, 0.75 * h.y, 0.9 * h.z), vec3(0.3 * h.x, -0.7 * h.y, 0.55 * h.z), 0.0);
        float fn = smoothstep(0.3, 0.55, Noise3(pl * (2.4 / mn) + seed));
        float fat = clamp(smoothstep(0.1, 0.8, yy) * fn + (1.0 - smoothstep(0.1 * h.x, 0.4 * h.x, grv)) * fn, 0.0, 1.0);
        albedo = mix(albedo, vec3(0.9, 0.76, 0.46), fat * 0.9);
        float cor = 1.0 - smoothstep(0.0, 0.07, abs(Noise3(pl * (2.4 / mn) + seed * 4.0) - 0.5));
        albedo = mix(albedo, vec3(0.5, 0.06, 0.06), 0.55 * cor * (0.4 + fat));
        float ves = smoothstep(1.02, 1.12, yy);
        vec3 vc = pl.x < -0.55 * h.x ? vec3(0.45, 0.35, 0.55) : vec3(0.82, 0.62, 0.56);
        albedo = mix(albedo, vc, ves * 0.9);
        albedo = mix(albedo, tint * dot(albedo, lumW) * 1.8, 0.15);
        gloss = 0.55;
        sssK = 1.0;
    } else if (ty < 5.5) {
        // Eye: bloodshot white, an iris and a black pupil on the +x side, pink at the nerve.
        float r = length(pl.yz) / h.x;
        float front = pl.x / h.x;
        albedo = vec3(0.93, 0.89, 0.84);
        float vein = 1.0 - smoothstep(0.0, 0.08, abs(Noise3(pl * (3.2 / h.x) + seed) - 0.5));
        albedo = mix(albedo, vec3(0.75, 0.12, 0.12), vein * 0.7 * (0.4 + 0.6 * (1.0 - front)));
        float hs = Hash3(vec3(seed, 9.0, 4.0));
        vec3 iris = hs < 0.4 ? vec3(0.2, 0.45, 0.8) : (hs < 0.7 ? vec3(0.25, 0.6, 0.3) : vec3(0.45, 0.25, 0.08));
        float irisM = (1.0 - smoothstep(0.4, 0.46, r)) * smoothstep(0.5, 0.65, front);
        iris *= 0.7 + 0.6 * Noise3(vec3(atan(pl.z, pl.y) * 3.0, r * 9.0, seed));
        albedo = mix(albedo, iris, irisM);
        albedo = mix(albedo, vec3(0.01), (1.0 - smoothstep(0.16, 0.19, r)) * smoothstep(0.55, 0.7, front));
        albedo = mix(albedo, vec3(0.7, 0.3, 0.3), (1.0 - smoothstep(-1.0, -0.65, front)) * 0.9);
        albedo = mix(albedo, p_blood * 1.2, 0.5 * GD.w * smoothstep(0.55, 0.85, Noise3(pl * (1.0 / h.x) + seed * 2.0)) * (1.0 - 0.8 * irisM));
        gloss = 1.0;
        sssK = 0.6;
    } else if (ty < 6.5) {
        // Lung: pink and spongy, dark with blood in patches, with a bronchus stub that is pale and ribbed.
        float spo = Noise3(pl * (6.0 / mn) + seed * 2.0);
        albedo = mix(vec3(0.62, 0.26, 0.28), vec3(0.8, 0.42, 0.42), mott);
        albedo = mix(albedo, vec3(0.34, 0.07, 0.08), smoothstep(0.5, 0.75, Noise3(pl * (1.6 / mn) + seed * 4.0)) * 0.7);
        albedo *= 0.8 + 0.4 * spo;
        albedo = mix(albedo, vec3(0.8, 0.68, 0.62), smoothstep(1.05, 1.3, pl.y / h.y));
        albedo = mix(albedo, mix(vec3(0.5, 0.08, 0.08), vec3(0.82, 0.32, 0.28), fine), raw * 0.85);
        gloss = 0.4;
        sssK = 1.0;
    } else {
        // Intestine: a wet grey-pink tube, glistening, with darker pink bands where it narrows and a pale fatty mesentery, the
        // open ends dark red.
        float bands = 0.5 + 0.5 * cos(atan(abs(pl.x), pl.z) * 9.0 + seed);
        albedo = mix(vec3(0.6, 0.34, 0.33), vec3(0.74, 0.5, 0.46), mott);
        albedo = mix(albedo, vec3(0.5, 0.2, 0.2), 0.35 * bands);
        albedo = mix(albedo, vec3(0.88, 0.76, 0.52), smoothstep(0.55, 0.75, Noise3(pl * (1.6 / mn) + seed * 3.0)) * 0.7);
        albedo *= 0.9 + 0.2 * fine;
        gloss = 0.7;
        sssK = 0.9;
    }
    // A film of blood on everything that is wet, thicker in the low spots.
    float film = smoothstep(0.62, 0.92, Noise3(p * 0.8 + seed * 5.0) + 0.3 * (1.0 - n.y) + 0.3 * GD.w) * wet;
    albedo = mix(albedo, p_blood * 1.1, 0.4 * film);
    // Dark clotted blood gathers in the crevices.
    float clot = (1.0 - ao) * smoothstep(0.2, 0.6, fine + 0.3 * GD.w);
    albedo = mix(albedo, vec3(0.1, 0.012, 0.014), clamp(clot * 1.6, 0.0, 0.75));
    // Drying: darker and browner, then dull.
    albedo = mix(albedo, albedo * vec3(0.52, 0.42, 0.38) + vec3(0.02, 0.01, 0.005), dry * 0.85);
    gloss *= 0.18 + 0.82 * wet + 0.35 * film;

    // Scene light around the pixel: the same for the whole gib, so it dims in shadow and warms in sun.
    vec2 px = mg_resolution.zw * 7.0;
    vec3 around = (texture2D(mg_scene, mg_uv + vec2(px.x, 0.0)).rgb + texture2D(mg_scene, mg_uv - vec2(px.x, 0.0)).rgb
                 + texture2D(mg_scene, mg_uv + vec2(0.0, px.y)).rgb + texture2D(mg_scene, mg_uv - vec2(0.0, px.y)).rgb) * 0.25;
    float expo = clamp(0.55 + 1.0 * dot(around, lumW), 0.5, 1.35);

    // The fill comes from the side of the camera, a little above it.
    vec3 Lf = normalize(vec3(-0.55, 0.25, 0.8) * mat3(mg_view));
    float ndl = dot(n, Lk);
    float wrap = clamp((ndl + 0.45) / 1.45, 0.0, 1.0);
    vec3 keyCol = vec3(1.0, 0.95, 0.88) * 1.1;
    vec3 fillCol = vec3(0.45, 0.5, 0.62) * 0.5;
    vec3 sssCol = vec3(1.0, 0.22, 0.12);
    float dfill = clamp(dot(n, Lf) * 0.5 + 0.5, 0.0, 1.0);
    vec3 col = albedo * (keyCol * wrap * wrap * shade + fillCol * dfill * ao + around * 0.9 * ao) * expo;
    // Light through the thin flesh: red at the terminator on the lit side, and glowing at the edge against the light.
    float sss = clamp(1.0 - abs(ndl) * 1.7, 0.0, 1.0) * clamp(ndl + 0.6, 0.0, 1.0);
    float back = pow(clamp(dot(V, -Lk), 0.0, 1.0), 2.0) * (0.3 + 0.7 * (1.0 - nv));
    col += albedo * sssCol * (0.3 * sss * (0.4 + 0.6 * shade) + 0.25 * back * shade) * sssK * (1.0 - 0.6 * dry) * expo * (0.5 + 0.5 * ao);

    // Wet: a thin film, not a glaze. A broad, weak sheen from the key and a smaller one from the fill, broken up by patches
    // (the film is thick here and gone there), fresnel reflection of a dull sky and a faint rim. Only the cornea of the eye is
    // glassy.
    float wp = 0.15 + 0.85 * smoothstep(0.3, 0.7, Noise3(p * 0.7 + seed * 7.0));
    float gl = clamp(isEye ? gloss : gloss * wp * (0.7 + 0.5 * fine), 0.0, 1.2);
    vec3 H = normalize(Lk + V);
    float nh = max(dot(n, H), 0.0);
    float fres = pow(1.0 - nv, 5.0);
    float spec = isEye ? pow(nh, 220.0) * 2.4 + pow(nh, 38.0) * 0.3 : pow(nh, 30.0) * 0.6 + pow(nh, 8.0) * 0.1;
    vec3 H2 = normalize(Lf + V);
    float spec2 = pow(max(dot(n, H2), 0.0), isEye ? 90.0 : 24.0) * (isEye ? 0.5 : 0.2);
    col += keyCol * spec * gl * (0.5 + 0.5 * fres) * shade * (0.5 + 0.5 * ao);
    col += fillCol * 2.0 * spec2 * gl * ao;
    vec3 R = reflect(-V, n);
    vec3 sky = mix(vec3(0.16, 0.14, 0.15), vec3(0.72, 0.8, 0.95), clamp(R.y * 0.5 + 0.5, 0.0, 1.0));
    col += sky * (0.02 + 0.3 * fres) * gl * ao * expo;
    col += pow(1.0 - nv, 3.0) * 0.1 * vec3(0.95, 0.42, 0.42) * gl * (0.4 + 0.6 * shade) * expo;

    vec3 outc = mix(base, col, cover);
    gl_FragColor = vec4(mix(scene.rgb, outc, p_strength), scene.a);
}
