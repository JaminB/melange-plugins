{
  "spiceVersion": 1,
  "id": "sunstone",
  "version": "2.0.0",
  "name": "Sunstone",
  "authors": ["Melange"],
  "description": "A client-only graphics overhaul with natural colour, light, atmosphere, ambient occlusion, soft shadows, per-pixel lighting and water that reflects the scenery; no effect on the simulation.",
  "website": "https://github.com/JaminB/melange-plugins/tree/main/plugins/sunstone",
  "kind": "client-only",
  "melange": { "range": ">=0.3.0 <0.4.0" },
  "permissions": { "unsafe": false, "filesystem": "none" },
  "dependencies": [],
  "conflicts": [],
  "entry": { "client": "client/init.lua" },
  "graphics": { "anisotropy": 16, "trilinearFilter": true, "shadowMapSize": 2048 },
  "settings": [
    {
      "key": "quality",
      "type": "enum",
      "options": ["off", "low", "subtle", "bold", "ultra"],
      "default": "bold",
      "label": "Quality"
    },
    {
      "key": "look",
      "type": "enum",
      "options": ["golden", "dusk"],
      "default": "golden",
      "label": "Look"
    },
    {
      "key": "water",
      "type": "bool",
      "default": true,
      "label": "Sunstone water"
    },
    {
      "key": "lighting",
      "type": "bool",
      "default": true,
      "label": "Sunstone lighting"
    },
    {
      "key": "dof",
      "type": "bool",
      "default": true,
      "label": "Distance blur"
    },
    {
      "key": "grain",
      "type": "bool",
      "default": true,
      "label": "Film grain"
    },
    {
      "key": "lens",
      "type": "bool",
      "default": true,
      "label": "Lens effects (dirt, flare, colour fringes)"
    }
  ]
}
