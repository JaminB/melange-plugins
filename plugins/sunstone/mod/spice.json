{
  "spiceVersion": 1,
  "id": "sunstone",
  "version": "2.2.0",
  "name": "Sunstone",
  "authors": ["Melange"],
  "description": "A dramatic, client-only graphics overhaul: sharper textures, anti-aliasing and sharpening, grading, atmosphere (SSAO, aerial perspective, bloom), soft shadows, per-pixel lighting and water. No effect on the simulation.",
  "website": "https://github.com/JaminB/melange-plugins/tree/main/plugins/sunstone",
  "kind": "client-only",
  "melange": { "range": ">=0.3.0" },
  "permissions": { "unsafe": false, "filesystem": "none" },
  "dependencies": [],
  "conflicts": [],
  "entry": { "client": "client/init.lua" },
  "graphics": { "anisotropy": 16, "trilinearFilter": true, "shadowMapSize": 2048 },
  "settings": [
    {
      "key": "quality",
      "type": "enum",
      "options": ["off", "low", "subtle", "bold", "ultra"],
      "default": "bold",
      "label": "Quality"
    },
    {
      "key": "look",
      "type": "enum",
      "options": ["golden", "dusk"],
      "default": "golden",
      "label": "Look"
    },
    {
      "key": "water",
      "type": "bool",
      "default": true,
      "label": "Sunstone water"
    },
    {
      "key": "lighting",
      "type": "bool",
      "default": true,
      "label": "Sunstone lighting"
    },
    {
      "key": "dof",
      "type": "bool",
      "default": true,
      "label": "Distance blur"
    },
    {
      "key": "grain",
      "type": "bool",
      "default": true,
      "label": "Film grain"
    },
    {
      "key": "lens",
      "type": "bool",
      "default": true,
      "label": "Lens effects (dirt, flare, colour fringes)"
    },
    {
      "key": "materials",
      "type": "bool",
      "default": true,
      "label": "Material detail (wood grain, metal wear, fabric weave and more on props, weapons and worm gear; needs Sunstone lighting)"
    },
    {
      "key": "skin",
      "type": "enum",
      "options": ["game", "fair", "light", "medium", "olive", "tan", "brown", "deep", "mixed"],
      "default": "game",
      "label": "Worm skin (game = the game's peach; a tone = realistic human skin; mixed = a tone per worm)"
    },
    {
      "key": "hair",
      "type": "enum",
      "options": ["game", "natural", "mixed"],
      "default": "game",
      "label": "Worm hair (game = the game's moustaches; natural = realistic hair in each moustache's own colour; mixed = a natural hair colour per worm)"
    },
    {
      "key": "wigs",
      "type": "bool",
      "default": false,
      "label": "Realistic hair hats too (experimental: afros, pigtails, crests and other hair hats drawn as hair; needs Worm hair on)"
    }
  ]
}
