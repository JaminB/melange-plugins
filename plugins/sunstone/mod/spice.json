{
  "spiceVersion": 1,
  "id": "sunstone",
  "version": "1.3.0",
  "name": "Sunstone",
  "authors": ["Melange"],
  "description": "A dramatic, client-only graphics overhaul: sharper textures, anti-aliasing and sharpening, grading, and atmosphere (SSAO, aerial perspective, bloom). No effect on the simulation.",
  "website": "https://github.com/JaminB/melange-plugins/tree/main/plugins/sunstone",
  "kind": "client-only",
  "melange": { "range": ">=0.3.0 <0.4.0" },
  "permissions": { "unsafe": false, "filesystem": "none" },
  "dependencies": [],
  "conflicts": [],
  "entry": { "client": "client/init.lua" },
  "graphics": { "anisotropy": 16, "trilinearFilter": true, "shadowMapSize": 2048 },
  "settings": [
    {
      "key": "quality",
      "type": "enum",
      "options": ["off", "low", "medium", "high"],
      "default": "medium",
      "label": "Quality"
    },
    {
      "key": "look",
      "type": "enum",
      "options": ["golden", "dusk"],
      "default": "golden",
      "label": "Look"
    }
  ]
}
