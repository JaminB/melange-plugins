#version 130
// Sunstone landscape lighting: hemispheric sky/ground ambient, energy-conserving Blinn-Phong, a rim light, fine
// relief taken from the texture and world-space detail, with foliage-aware diffuse, over contact-hardening soft
// shadows. sunstoneLight 0 keeps the game's own terms.
uniform sampler2D texture0;
uniform sampler2DShadow shadowMap;
uniform vec3 shadowSize;
uniform vec3 globalDiffuse;
uniform vec3 globalAmbient;
uniform vec3 globalSpecular;
uniform vec3 globalFresnel;
// The vertex program's view matrix: columns 0-2 are the world's axes in eye space (column 1 is up), column 3 the
// translation.
uniform mat4 view;

// Tunables (shaders/params.ini). Shadow mode 0 = the game's own 3x3 filter, 1 = soft, 2 = soft with contact
// hardening; mode + 10 shows the shadow term alone.
uniform float sunstoneShadowMode;
uniform float sunstoneShadowSoftness;  // kernel step in map texels (1-2); wider steps start to band
uniform float sunstoneShadowContact;   // blocker distance (shadow depth) at which the penumbra is at its widest
uniform float sunstoneShadowBias;      // receiver depth offset (shadow depth), grows on slopes
uniform float sunstoneShadowSlope;     // further offset along the receiver's slope in the map (map texels)
uniform float sunstoneLight;           // 0 game lighting, 1 Sunstone; + 10 shows the lighting on grey
uniform vec3 sunstoneSky;              // ambient tint for surfaces facing up
uniform vec3 sunstoneGround;           // ambient tint for surfaces facing down
uniform float sunstoneSpecular;        // specular reflectance at normal incidence
uniform float sunstoneGloss;           // Blinn-Phong exponent
uniform float sunstoneRim;             // rim light strength
uniform float sunstoneRelief;          // texture relief depth (world units)
uniform float sunstoneReliefFade;      // distance at which the relief has faded out
uniform float sunstoneSunGain;         // sun (diffuse) gain
uniform float sunstoneAmbientGain;     // ambient gain
uniform float sunstoneShadowAmbient;   // ambient dip inside sun shadows
uniform float sunstoneShadeChroma;     // saturation boost of the ambient light, so shade keeps its colour
uniform float sunstoneDetail;          // luminance variation of the world-space detail noise (+/- this fraction)
uniform float sunstoneDetailBump;      // micro-normal strength of the detail noise
uniform float sunstoneDetailFade;      // distance at which the detail has faded out
uniform float sunstoneGrassWrap;       // diffuse wrap on green surfaces
uniform float sunstoneTransmit;        // back-transmission through green surfaces
uniform float sunstonePatch;           // low-frequency brightness patches on green surfaces (+/- this fraction)
uniform float sunstonePatchHue;        // warm and cool patches on green surfaces
uniform float sunstoneGreenSpec;       // specular reduction on green surfaces
uniform float sunstoneGreenWarm;       // warmer sunlight and shade that stays green on green surfaces
uniform float sunstoneFoliage;         // meadow hue shift toward yellow-green (degrees)
uniform float sunstoneFoliageCap;      // meadow chroma cap (0 none)
uniform float sunstoneShadeShift;      // share of the meadow hue shift kept in shade
uniform float sunstoneTuft;            // tufts on green surfaces: brightness variation along the wind (+/- this fraction)
uniform float sunstoneSheen;           // sky sheen on green surfaces at grazing angles
uniform float sunstoneCanopy;          // normal curvature (per world unit) above which a green surface is a canopy
uniform float sunstoneRollHue;         // highlight roll-off: 0 per channel (the game's hues), 1 hue-preserving
uniform vec3 sunstoneSunTint;          // tint of the direct light
uniform vec3 sunstoneShadowTint;       // tint of the ambient light inside shadows
uniform float sunstoneTint;            // how far the two tints apply (0 none)
uniform float sunstoneDebug;           // 1 world position (fract(pos / 100)); 2 detail; 3 green mask (red) and meadow (green); 4 sun direction
uniform float sunstoneSplit;           // pixels left of this x keep the game's lighting and shadows (comparisons)
uniform float sunstoneRenderScale;      // the scene over the window: 2 at 2x2 supersampling (set by init.lua)

// BEGIN MATERIALS (generated by tools/build_materials.py from tools/materials; do not edit by hand)
// ---- _common.glsl: the material library's shared part (inputs, outputs, helpers). See tools/materials/README.md.
// Spliced into the lit textured model shaders by tools/build_materials.py, after the host's own uniforms (texture0,
// materialMatrix, view, sunstoneLight, sunstoneSplit) and GameTerms(). Every name here starts with Mat or MAT_.

// Melange's texture tag for the texture bound on unit 0: [0] = (class id, scale, strength, roughness bias),
// [1] = (wear, tint variation, class parameter a, class parameter b). All zero for an untagged texture or a Melange
// without texture tags (it then logs that the uniform "stays 0" once at link).
uniform vec4 mg_texTag[2];
uniform float sunstoneMatDetail;   // material detail amount: 0 off, 1 full (Subtle sends 0.5; set by Sunstone)
uniform float sunstoneMatSplit;    // pixels left of this x are drawn without material detail (A/B comparisons)
uniform float sunstoneMatDebug;    // 1 class colours; 2 fade; 3 normal detail; 4 cavity

// Shared material maps (mod/assets/detail/materials.png, made by tools/make_detail_maps.py): eight original tileable
// 256x256 layers in one texture array, bound by init.lua with wum.shaders.setTexture (Melange 0.10; the host shader is
// #version 130 for sampler2DArray). Every channel 0.5 = neutral, which is also what Melange's sampler reads before a
// texture is bound: R,G tangent normal xy (x along +u, y along +v), B height (0.5 the surface, below cavities), A a
// variation about 0.5 (roughness + rougher, or albedo + lighter; the wear order on MAT_MAP_WEAR). Mips are plain
// averages: the normal flattens with distance. The helpers (MatMap...) follow MatFbm; layers and scales:
// tools/materials/README.md.
uniform sampler2DArray sunstoneMat;
const float MAT_MAP_GRAIN = 0.0;    // fine grain and pores (plastic, paint, skin-like matte); A roughness
const float MAT_MAP_WOOD = 1.0;     // wood grain along u with pores; A albedo
const float MAT_MAP_BRUSHED = 2.0;  // brushed metal along u, scratches at all angles; A roughness
const float MAT_MAP_STONE = 3.0;    // stone / concrete: pits, veins, mottle; A albedo
const float MAT_MAP_WEAVE = 4.0;    // plain weave, 16 threads a tile, fibres; A albedo
const float MAT_MAP_BUMPS = 5.0;    // leather / rubber / organic pebbling with creases; A roughness
const float MAT_MAP_WEAR = 6.0;     // chips, scratches, scuffs; A the wear order (worn where A > 1 - wear)
const float MAT_MAP_BARK = 7.0;     // bark fissures along v and a crack network; A albedo
const float MAT_MAP_TEXELS = 256.0; // a layer's size

const vec3 MAT_LUMW = vec3(0.299, 0.587, 0.114);
// Beyond this distance from the camera (world units) detail is gone (and starts going at a third of it).
const float MAT_FADE_FAR = 3000.0;

// What a snippet gets. Eye space = the game's view space (camera at 0; the same units as the world).
struct MatIn {
    vec3 albedo;      // the texel's colour, 0..1 (the base albedo, before Sunstone's leaf hue shift)
    float alpha;      // the texel's alpha
    vec2 uv;          // texture coordinate (GL_REPEAT space: whole numbers are the texture's own wrap)
    vec2 uvDx;        // its screen derivatives, per pixel
    vec2 uvDy;
    float uvPx;       // texture units one pixel covers (the larger axis)
    float uvPerWorld; // texture units per world unit on this triangle (a worm's head is about 12 world units)
    float pxWorld;    // world units one pixel covers here
    float aniso;      // how far the texture is stretched on the surface (1 none; 2 twice as long one way)
    vec3 pos;         // eye-space position
    vec3 wpos;        // world position (props move: prefer uv, which sticks to the surface)
    vec3 n;           // unit normal, eye space (no detail)
    vec3 gu;          // eye-space surface gradient of u (texture units per world unit, steepest direction)
    vec3 gv;          // eye-space surface gradient of v
    vec3 tu;          // unit direction of increasing u along the surface (the cotangent frame; the mesh has none)
    vec3 tv;          // unit direction of increasing v
    vec3 v;           // unit vector toward the eye
    vec3 l;           // unit vector toward the sun
    vec3 up;          // the world's up, eye space
    float ndl;        // dot(n, l), unclamped
    float ndv;        // dot(n, v), at least 0
    float sky;        // 0 facing the ground .. 1 facing the sky
    vec2 lumD;        // screen derivatives (x, y) of the texel's luminance: the art's own edges
    float scale;      // tag: feature size multiplier (1 the snippet's own sizes; 2 twice as big)
    float strength;   // tag: strength (the dispatcher applies it to the result; read it only to shape detail)
    vec4 p;           // tag: (wear, tint variation, class parameter a, class parameter b), see the snippet's @default
    float fade;       // 0..1 distance and grazing-angle fade (the dispatcher applies it; use it to skip work)
    float seed;       // 0..1, differs between textures with different tag parameters
    float tagged;     // 1 the tag came from Melange; 0 the class was guessed from the material
};

// What a snippet returns. MatNone(m.albedo) is "no change"; start from it.
struct MatOut {
    vec3 albedo;      // new albedo (keep the art's hue and value: detail is mostly light, not paint)
    float spec;       // specular scale (1 the material's own)
    float gloss;      // gloss scale, the Blinn-Phong exponent (1 the material's own; < 1 rougher)
    vec3 dn;          // normal perturbation, eye space, added to n before normalising (from MatBumpUv / MatBumpScreen)
    float ao;         // cavity and occlusion, 0..1 (1 none): darkens ambient fully and direct light a third
};

MatOut MatNone(vec3 albedo) {
    return MatOut(albedo, 1.0, 1.0, vec3(0.0), 1.0);
}

float MatLum(vec3 c) {
    return dot(c, MAT_LUMW);
}

// ---- hashes (no sine: stable for big coordinates)
float MatHash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}
vec2 MatHash22(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.xx + p3.yz) * p3.zy);
}
vec3 MatHash32(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(0.1031, 0.1030, 0.0973));
    p3 += dot(p3, p3.yxz + 33.33);
    return fract((p3.xxy + p3.yzz) * p3.zyx);
}

// ---- gradient noise on the texture's plane, with its slope: (value about -0.5..0.5, d/dp.x, d/dp.y).
// period > 0 wraps the lattice every period cells: with p = uv * F and period = F (F a whole number) the noise
// repeats with the texture, so a GL_REPEAT seam stays seamless. period 0: no wrap.
vec2 MatGrad(vec2 i, float period) {
    if (period > 0.0) i = mod(i, period);
    return MatHash22(i) * 2.0 - 1.0;
}
vec3 MatGNoise(vec2 p, float period) {
    vec2 i = floor(p), f = fract(p), e = vec2(1.0, 0.0);
    vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0), du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
    vec2 ga = MatGrad(i, period), gb = MatGrad(i + e, period), gc = MatGrad(i + e.yx, period), gd = MatGrad(i + 1.0, period);
    float va = dot(ga, f), vb = dot(gb, f - e), vc = dot(gc, f - e.yx), vd = dot(gd, f - 1.0), k = va - vb - vc + vd;
    return vec3(va + u.x * (vb - va) + u.y * (vc - va) + u.x * u.y * k,
                ga + u.x * (gb - ga) + u.y * (gc - ga) + u.x * u.y * (ga - gb - gc + gd) + du * (u.yx * k + vec2(vb, vc) - va));
}

// ---- footprint: how much of a pattern survives at this pixel. cellsPx = pattern cells per pixel: 1 below 0.25
// (four pixels a cell), 0 from 0.5 (the Nyquist limit), so nothing ever shimmers or crawls.
float MatFadeCells(float cellsPx) {
    return 1.0 - smoothstep(0.25, 0.5, cellsPx);
}
// For a pattern of freq cells per texture unit.
float MatFadeUv(MatIn m, float freq) {
    return MatFadeCells(freq * m.uvPx);
}
// For features sizeWorld world units apart.
float MatFadeWorld(MatIn m, float sizeWorld) {
    return MatFadeCells(m.pxWorld / max(sizeWorld, 1e-4));
}

// Features sizeWorld world units apart, on the texture's plane: F0 (cells per texture unit, a power of two, so the
// pattern repeats with the texture; pass it as MatGNoise's period) and the blend toward the next octave 2 * F0.
// Blend the two octaves with it so the size never jumps between triangles of different texel density.
void MatOctave(MatIn m, float sizeWorld, out float F0, out float blend) {
    float lf = clamp(-log2(max(sizeWorld * m.uvPerWorld, 1e-6)), 0.0, 13.0);
    F0 = exp2(floor(lf));
    blend = lf - floor(lf);
}

// fbm of up to 4 octaves from freq cells per texture unit (a whole number, or 0 period for no wrap), each octave faded
// by its own footprint: (value, d/duv). Lacunarity 2, gain 0.5.
vec3 MatFbm(MatIn m, vec2 uv, float freq, float octaves) {
    vec3 s = vec3(0.0);
    float a = 1.0, f = freq;
    for (int i = 0; i < 4; i++) {
        if (float(i) >= octaves) break;
        float k = MatFadeUv(m, f);
        if (k <= 0.0) break;
        vec3 g = MatGNoise(uv * f + float(i) * 17.31, f);
        s += a * k * vec3(g.x, g.yz * f);
        a *= 0.5;
        f *= 2.0;
    }
    return s;
}

// ---- normal detail. A height field h(uv) in world units with slope dh = (dh/du, dh/dv): the perturbation that tilts
// the normal by it (dh from MatGNoise is per noise cell: multiply its .yz by the frequency and by the height).
vec3 MatBumpUv(MatIn m, vec2 dh) {
    return -(dh.x * m.gu + dh.y * m.gv);
}
// A height with screen derivatives dxy (world units per pixel in x and y), e.g. m.lumD * depth.
vec3 MatBumpScreen(MatIn m, vec2 dxy) {
    vec3 dpx = dFdx(m.pos), dpy = dFdy(m.pos);
    vec3 r1 = cross(dpy, m.n), r2 = cross(m.n, dpx);
    float det = dot(dpx, r1);
    return -(dxy.x * r1 + dxy.y * r2) / (abs(det) > 1e-20 ? det : 1e-20);
}

// ---- shared material maps (sunstoneMat, above). The sample is a vec4; 0.5 in every channel is neutral.
// The raw sample of layer at uvScaled (the map's own coordinates: one tile per unit, e.g. m.uv * 8.0), the mip and
// anisotropy from the sampler. Implicit derivatives: only in uniform control flow, i.e. not after a per-fragment
// branch in a snippet (such as 'if (m.fade <= 0.0) return o;'); MatMapAt is safe anywhere.
vec4 MatMap(float layer, vec2 uvScaled) {
    return texture(sunstoneMat, vec3(uvScaled, layer));
}
// The map tiled freq times per texture unit (a whole number keeps the texture's own wrap seamless) at
// m.uv * freq + offset, with explicit derivatives (the same mip and anisotropy as MatMap, safe in any branch).
vec4 MatMapAt(MatIn m, float layer, float freq, vec2 offset) {
    return textureGrad(sunstoneMat, vec3(m.uv * freq + offset, layer), m.uvDx * freq, m.uvDy * freq);
}
// Footprint fade for a map tiled freq times per texture unit whose features are about texels map texels across:
// 1 while a feature covers four pixels or more, 0 at two (where its lighting would sparkle). The mips flatten the
// normal by themselves; this takes what a snippet derives from the sample (gloss, cavity) to neutral before it aliases.
float MatMapFade(MatIn m, float freq, float texels) {
    return MatFadeUv(m, freq * MAT_MAP_TEXELS / max(texels, 1e-3));
}
// A sample pulled toward neutral (vec4(0.5)): k 1 the sample, 0 neutral (e.g. k = MatMapFade(...)).
vec4 MatMapNeutral(vec4 s, float k) {
    return mix(vec4(0.5), s, k);
}
// A layer sized in world units: a tile about tileWorld world units across (multiply by m.scale yourself), the two
// power-of-two octaves around it blended (MatOctave) so the size never jumps between triangles, faded to neutral by
// the footprint of features texels across. Two samples.
vec4 MatMapWorld(MatIn m, float layer, float tileWorld, float texels) {
    float F0, fb;
    MatOctave(m, tileWorld, F0, fb);
    vec4 s = mix(MatMapAt(m, layer, F0, vec2(0.0)), MatMapAt(m, layer, 2.0 * F0, vec2(0.37, 0.61)), fb);
    return MatMapNeutral(s, MatMapFade(m, F0 * (1.0 + fb), texels));
}
// The eye-space normal perturbation (for MatOut.dn) of a sample's R,G; amount 1 = the map's own slopes.
vec3 MatMapBump(MatIn m, vec4 s, float amount) {
    vec2 t = (s.xy * 2.0 - 1.0) * amount;
    return t.x * m.tu + t.y * m.tv;
}
// A sample's height about the surface (-0.5..0.5, < 0 cavities) and its variation (-0.5..0.5).
float MatMapHeight(vec4 s) {
    return s.z - 0.5;
}
float MatMapVar(vec4 s) {
    return s.w - 0.5;
}

// ---- colour: a variation of up to amount in brightness with a touch of warmth, keeping the art's hue (r: -1..1).
vec3 MatVary(vec3 c, float amount, float r) {
    return c * (1.0 + amount * r * vec3(1.02, 1.0, 0.97));
}

// ---- degenerate mapping guard. Where a texture's footprint on the surface collapses (UVs that converge to a point, as
// in a gun's bore or a cone's tip; a texture stretched along one direction; a texture spread over hundreds of world
// units or squeezed into a fraction of one) the world-space detail that follows the UVs pinches into stars and streaks,
// and the divisions by uvPerWorld and the surface gradients blow up. This is 1 for every ordinary mapping and falls to 0
// as the mapping degenerates; MatSetup folds it into m.fade, which the dispatcher applies to everything.
//   - stretch (aniso): 1 up to 3 (a plane at a steep angle is about 3), 0 from 8
//   - the texel density changing fast across the screen (uvPerWorld halving every few pixels: a converging mapping):
//     1 below 0.06 octaves a pixel, 0 from 0.2 (1/r of the pinch: it clears about 20 pixels from the point)
//   - an extreme density: a tile over 1000 world units, or under one-twentieth of a unit
float MatDegenerate(MatIn m) {
    float lg = log2(m.uvPerWorld);
    float rate = abs(dFdx(lg)) + abs(dFdy(lg));
    float g = 1.0 - smoothstep(3.0, 8.0, m.aniso);
    g *= 1.0 - smoothstep(0.06, 0.2, rate);
    g *= smoothstep(1e-3, 4e-3, m.uvPerWorld) * (1.0 - smoothstep(20.0, 60.0, m.uvPerWorld));
    return g;
}

// The inputs for this fragment. Call only in uniform control flow (MatEnabled() is uniform): it takes derivatives.
MatIn MatSetup(vec4 tex, vec2 uv) {
    MatIn m;
    m.albedo = tex.rgb;
    m.alpha = tex.a;
    m.uv = uv;
    m.uvDx = dFdx(uv);
    m.uvDy = dFdy(uv);
    m.uvPx = max(length(m.uvDx), length(m.uvDy));
    m.pos = -gl_TexCoord[1].xyz;
    m.wpos = (m.pos - view[3].xyz) * mat3(view);
    m.n = normalize(gl_TexCoord[2].xyz);
    m.v = normalize(gl_TexCoord[1].xyz);
    m.l = normalize(-gl_TexCoord[3].xyz);
    vec3 up = view[1].xyz;
    m.up = dot(up, up) > 0.25 ? normalize(up) : m.l;
    m.ndl = dot(m.n, m.l);
    m.ndv = max(dot(m.n, m.v), 0.0);
    m.sky = dot(m.n, m.up) * 0.5 + 0.5;
    float lum = MatLum(tex.rgb);
    m.lumD = vec2(dFdx(lum), dFdy(lum));
    // The cotangent frame (no tangents in the mesh): surface gradients of u and v from the screen derivatives.
    vec3 dpx = dFdx(m.pos), dpy = dFdy(m.pos);
    vec3 r1 = cross(dpy, m.n), r2 = cross(m.n, dpx);
    float det = dot(dpx, r1);
    det = abs(det) > 1e-20 ? det : 1e-20;
    m.gu = (r1 * m.uvDx.x + r2 * m.uvDy.x) / det;
    m.gv = (r1 * m.uvDx.y + r2 * m.uvDy.y) / det;
    float gu2 = dot(m.gu, m.gu), gv2 = dot(m.gv, m.gv);
    m.tu = gu2 > 1e-24 ? m.gu * inversesqrt(gu2) : normalize(cross(m.n, vec3(0.31, 0.95, 0.0)));
    m.tv = gv2 > 1e-24 ? m.gv * inversesqrt(gv2) : normalize(cross(m.tu, m.n));
    float areaW = length(cross(dpx, dpy));
    float areaUv = abs(m.uvDx.x * m.uvDy.y - m.uvDx.y * m.uvDy.x);
    m.uvPerWorld = max(sqrt(areaUv / max(areaW, 1e-24)), 1e-6);
    m.pxWorld = sqrt(areaW);
    float tt = gu2, bb = gv2, tb = dot(m.gu, m.gv), tr = tt + bb, dg = max(tt * bb - tb * tb, 1e-36);
    float sa = sqrt(max(tr * tr - 4.0 * dg, 0.0));
    m.aniso = sqrt(max((tr + sa) / max(tr - sa, 1e-30), 1.0));
    float d = length(m.pos);
    m.fade = (1.0 - smoothstep(MAT_FADE_FAR / 3.0, MAT_FADE_FAR, d)) * smoothstep(0.03, 0.2, m.ndv) * MatDegenerate(m);
    m.scale = 1.0;
    m.strength = 1.0;
    m.p = vec4(0.0);
    m.seed = 0.0;
    m.tagged = 0.0;
    return m;
}
// ---- end _common.glsl

// ---- _land.glsl: the landscape's material detail, the light tier (owned by the library, not by a class worker).
// The models' snippets cost 0.3 to 0.9 ms more than the landscape's own shading on a 4K screen of landscape (2x2
// supersampled Ultra; GL timer queries on an RX 7800 XT), several times the 0.2 ms the landscape may take of the 0.5 ms
// Ultra budget: their gradient noises and art taps are sized for a prop that covers part of the screen, while the
// landscape covers most of it. So the landscape draws each class from what its model snippet is mostly made of, the
// shared material maps, at the same world sizes: one map sample a class (painted metal two: its wear), one octave (the
// landscape's texel density is the same over a whole surface, so no size can jump between triangles), the relief, the
// cavity, a little albedo variation, and the class's sheen. The art's own carving is the landscape's texture relief.
//
// The tag's fields: scale (feature size), strength, rough, wear (painted and rusted metal: chips; stone: grime in the
// pits), tint (albedo variation); a and b as the class snippet reads them where noted (wood: b's grain direction; sand:
// a clods; painted metal: a its gloss; stone: a < 0 polished).
// @classes stone_rock=6 brick=25 concrete_plaster=22 sand_dirt=20 wood_planks=7 grass_turf=24 leaf_foliage=4 snow_ice=23 rusted_metal=16 painted_metal=1

// One shared-map sample with features about tileWorld world units a tile, its power of two nearest the size (a whole
// number of map tiles per texture repeat keeps the landscape's tiling seamless), faded to neutral by its footprint.
// swap: the layer's direction (wood and brushed run along u) along v instead.
vec4 MatLandMap(MatIn m, float layer, float tileWorld, float texels, vec2 offset, bool swap) {
    float F = exp2(floor(clamp(-log2(max(tileWorld * m.uvPerWorld, 1e-6)), 0.0, 13.0) + 0.5));
    vec2 uv = swap ? m.uv.yx : m.uv, dx = swap ? m.uvDx.yx : m.uvDx, dy = swap ? m.uvDy.yx : m.uvDy;
    vec4 s = textureGrad(sunstoneMat, vec3(uv * F + offset, layer), dx * F, dy * F);
    return MatMapNeutral(s, MatMapFade(m, F, texels));
}

// MatMapBump for a sample taken with swap: its x runs along v.
vec3 MatLandBump(MatIn m, vec4 s, float amount, bool swap) {
    vec2 t = (s.xy * 2.0 - 1.0) * amount;
    return swap ? t.x * m.tv + t.y * m.tu : t.x * m.tu + t.y * m.tv;
}

MatOut mat_land(MatIn m, int c) {
    MatOut o = MatNone(m.albedo);
    if (m.fade <= 0.0) return o;
    // Per class (a uniform chain): the map, its tile (world units) and feature size (texels), relief, cavity, albedo
    // variation, specular and gloss. Defaults: stone and rock (the stone map, about 28 units: pits, veins, mottle).
    float layer = MAT_MAP_STONE, tile = 28.0, texels = 6.0, bump = 0.35, cav = 0.25, vary = 0.03, spec = 1.0, gloss = 1.0;
    bool swap = false, metal = false;
    if (c == 25) {                                  // brick, tile: fired clay, pits and sandy grain
        tile = 16.0; bump = 0.3; cav = 0.3;
    } else if (c == 22) {                           // concrete and plaster: pores, very matte
        tile = 18.0; bump = 0.3; cav = 0.2; vary = 0.025; spec = 0.85; gloss = 0.8;
    } else if (c == 20) {                           // sand and dirt: clods and pebbles, matte
        tile = 24.0; texels = 4.0; bump = 1.1 * m.p.z; cav = 0.3 * m.p.z; vary = 0.08; spec = 0.8; gloss = 0.7;
    } else if (c == 7) {                            // wood: grain along the art's grain, latewood sheen
        layer = MAT_MAP_WOOD; tile = 14.0; bump = 0.3; cav = 0.25; vary = 0.045; swap = mod(m.p.w, 2.0) >= 0.5;
    } else if (c == 24) {                           // grass: soft clumps
        layer = MAT_MAP_BUMPS; tile = 14.0; texels = 8.0; bump = 0.3; cav = 0.06; vary = 0.015; spec = 0.95; gloss = 0.6;
    } else if (c == 4) {                            // leaves: pebbled, a waxy sheen
        layer = MAT_MAP_BUMPS; tile = 12.0; texels = 8.0; bump = 0.25; cav = 0.1; vary = 0.03; spec = 1.1; gloss = 1.4;
    } else if (c == 23) {                           // snow and ice: fine grain, a sparkle of gloss
        layer = MAT_MAP_GRAIN; tile = 4.0; texels = 3.0; bump = 0.3; cav = 0.08; vary = 0.02; spec = 1.4; gloss = 1.6;
    } else if (c == 16) {                           // rusted metal: pitted, flaking, rough
        tile = 24.0; texels = 4.0; bump = 0.45; cav = 0.3; vary = 0.06; spec = 0.75; gloss = 0.5;
    } else if (c == 1) {                            // painted metal: fine paint grain; chips below
        layer = MAT_MAP_GRAIN; tile = 6.0; texels = 3.0; bump = 0.12; cav = 0.0; vary = 0.02;
        spec = mix(1.05, 1.3, clamp(m.p.z, 0.0, 1.0)); gloss = mix(1.0, 2.0, clamp(m.p.z, 0.0, 1.0)); metal = true;
    }
    vec4 s = MatLandMap(m, layer, tile * m.scale, texels, vec2(0.0), swap);
    float h = MatMapHeight(s), v = MatMapVar(s);
    float pit = smoothstep(-0.2, -0.42, h);
    o.dn = MatLandBump(m, s, bump, swap);
    o.ao = 1.0 - cav * pit;
    o.albedo = MatVary(m.albedo, vary * m.p.y, 2.0 * v);
    o.spec = spec * (1.0 - 0.5 * pit + 0.4 * max(h, 0.0));
    o.gloss = gloss * (1.0 - 0.3 * pit + 0.5 * max(h, 0.0));
    if (c == 6) {
        // Stone: grime (moss where the pits face the sky) by wear; polished (a < 0): a glassy sheen, no pits.
        float pol = clamp(-m.p.z, 0.0, 1.0);
        o.albedo *= mix(vec3(1.0), mix(vec3(0.85), vec3(0.84, 0.95, 0.78), smoothstep(0.55, 0.9, m.sky)), pit * m.p.x * 0.35);
        o.dn *= 1.0 - 0.75 * pol;
        o.gloss *= 1.0 + 1.5 * pol;
        o.spec *= 1.0 + 0.6 * pol;
    } else if (c == 7) {
        // Wood: latewood (darker bands) denser and a faint sheen, open pores rough.
        o.spec = 1.0 + 0.7 * -v + 0.35 * h;
        o.gloss = 1.0 + 0.6 * -v;
    }
    if (metal && m.p.x > 0.0) {
        // Painted metal: the wear map (a uniform branch on the tag), worn where its order passes 1 - wear: scuffed
        // paint, chips through the coat to steel.
        vec4 w = MatLandMap(m, MAT_MAP_WEAR, 40.0 * m.scale, 3.0, fract(m.seed * vec2(0.37, 0.71)), false);
        float thr = max(1.0 - 0.7 * m.p.x, 0.53);
        float worn = smoothstep(thr, thr + 0.03, w.a);
        float chip = worn * (1.0 - smoothstep(-0.2, -0.06, MatMapHeight(w)));
        float lum = MatLum(m.albedo);
        o.albedo = mix(o.albedo, vec3(mix(lum, 0.45, 0.35)) * vec3(0.95, 0.98, 1.03), 0.7 * chip);
        o.gloss = mix(o.gloss * (1.0 - 0.5 * (worn - chip)), 8.0, chip);
        o.spec = mix(o.spec, 2.2, chip);
        o.dn += MatMapBump(m, w, 1.0) * smoothstep(thr - 0.05, thr + 0.02, w.a);
        o.ao = 1.0 - 0.12 * chip;
    }
    return o;
}
// ---- end _land.glsl

// ---- generated: the landscape's class ids (tools/materials/classes.json) and their dispatch (light tier)
bool MatLandHas(int c) {
    return c == 1 || c == 4 || c == 6 || c == 7 || c == 16 || c == 20 || c == 22 || c == 23 || c == 24 || c == 25;
}
MatOut MatDispatchLand(int c, MatIn m) {
    return mat_land(m, c);
}

// ---- _evaluate_land.glsl: material detail on the landscape (after the generated MatDispatchLand). The landscape's
// counterpart of _evaluate.glsl: spliced with _common.glsl and the landscape's classes only (build_materials.py
// LANDSCAPE_CLASSES) into mod/shaders/Landscape.LandscapeFragmentMain.glsl and Landscape.HeightMapFragmentMain.glsl.
//
// The landscape draws its chunks one theme tile at a time (top, side and blend layers are separate draws, the blends
// alpha-blended over), so Melange's mg_texTag of a draw is that tile's tag. Its UVs are planar projections on the world
// axes, one tile 40 to 150 world units across, so the snippets' world-unit sizes hold as they do on models. A tile with
// no tag, or of a class not in LANDSCAPE_CLASSES, keeps Sunstone's World detail alone.

uniform float sunstoneMatFade;     // landscape: distance (world units) at which material detail has faded out

// For the debug views: the class drawn (0 none), its weight, normal detail and cavity.
int matClass = 0;
float matDbgFade = 0.0;
vec3 matDbgDn = vec3(0.0);
float matDbgAo = 1.0;

// Uniform: whether material detail runs at all (Sunstone's lighting on, not its grey view).
bool MatEnabled() {
    return sunstoneMatDetail > 0.0 && sunstoneLight > 0.5 && !(sunstoneLight > 9.5 && sunstoneLight < 10.5);
}

// Uniform: this draw's landscape class, 0 when its tile has none.
int MatLandClass() {
    int c = int(floor(mg_texTag[0].x + 0.5));
    return MatLandHas(c) ? c : 0;
}

// The inputs for this fragment, as MatSetup gives them but only what the landscape's detail reads (lumD, aniso, pxWorld
// and wpos stay 0): its planar UVs never degenerate, so the fade is the distance (full to a third of sunstoneMatFade),
// the grazing angle and the A/B split. Call only in uniform control flow: it takes derivatives.
MatIn MatSetupLand(vec4 tex, vec2 uv) {
    MatIn m;
    m.albedo = tex.rgb;
    m.alpha = tex.a;
    m.uv = uv;
    m.uvDx = dFdx(uv);
    m.uvDy = dFdy(uv);
    m.uvPx = max(length(m.uvDx), length(m.uvDy));
    m.pos = -gl_TexCoord[1].xyz;
    m.wpos = vec3(0.0);
    m.n = normalize(gl_TexCoord[2].xyz);
    m.v = normalize(gl_TexCoord[1].xyz);
    m.l = normalize(-gl_TexCoord[3].xyz);
    vec3 up = view[1].xyz;
    m.up = dot(up, up) > 0.25 ? normalize(up) : m.l;
    m.ndl = dot(m.n, m.l);
    m.ndv = max(dot(m.n, m.v), 0.0);
    m.sky = dot(m.n, m.up) * 0.5 + 0.5;
    m.lumD = vec2(0.0);
    vec3 dpx = dFdx(m.pos), dpy = dFdy(m.pos);
    vec3 r1 = cross(dpy, m.n), r2 = cross(m.n, dpx);
    float det = dot(dpx, r1);
    det = abs(det) > 1e-20 ? det : 1e-20;
    m.gu = (r1 * m.uvDx.x + r2 * m.uvDy.x) / det;
    m.gv = (r1 * m.uvDx.y + r2 * m.uvDy.y) / det;
    float gu2 = dot(m.gu, m.gu), gv2 = dot(m.gv, m.gv);
    m.tu = gu2 > 1e-24 ? m.gu * inversesqrt(gu2) : normalize(cross(m.n, vec3(0.31, 0.95, 0.0)));
    m.tv = gv2 > 1e-24 ? m.gv * inversesqrt(gv2) : normalize(cross(m.tu, m.n));
    float areaW = length(cross(dpx, dpy));
    float areaUv = abs(m.uvDx.x * m.uvDy.y - m.uvDx.y * m.uvDy.x);
    m.uvPerWorld = max(sqrt(areaUv / max(areaW, 1e-24)), 1e-6);
    m.pxWorld = 0.0;
    m.aniso = 1.0;
    float reach = max(sunstoneMatFade, 1.0);
    m.fade = (1.0 - smoothstep(reach / 3.0, reach, length(m.pos))) * smoothstep(0.03, 0.2, m.ndv)
           * (gl_FragCoord.x < sunstoneMatSplit ? 0.0 : 1.0);
    m.scale = 1.0;
    m.strength = 1.0;
    m.p = vec4(0.0);
    m.seed = 0.0;
    m.tagged = 0.0;
    return m;
}

// The tag's class and parameters, the snippet's result, and that result scaled by the detail amount, the tag's
// strength and the fade, with the tag's roughness bias.
MatOut MatEvaluateLand(MatIn m, int c) {
    vec4 t0 = mg_texTag[0], t1 = mg_texTag[1];
    m.tagged = 1.0;
    m.scale = t0.y > 0.0 ? t0.y : 1.0;
    m.strength = max(t0.z, 0.0);
    m.p = t1;
    m.seed = MatHash12(vec2(t0.y * 13.1 + t1.x * 7.7 + t1.z * 3.3 + float(c), t0.z * 5.3 + t1.y * 11.9 + t1.w * 2.9));
    MatOut o = MatDispatchLand(c, m);
    o.dn *= min(1.0, 0.7 / max(length(o.dn), 1e-6));
    float k = clamp(sunstoneMatDetail * m.strength * m.fade, 0.0, 2.0);
    o.gloss *= exp2(-2.0 * t0.w);
    o.spec *= exp2(-t0.w);
    MatOut r;
    r.albedo = clamp(mix(m.albedo, o.albedo, k), 0.0, 1.0);
    r.spec = max(mix(1.0, o.spec, k), 0.0);
    r.gloss = max(mix(1.0, o.gloss, k), 0.05);
    r.dn = o.dn * k;
    r.ao = clamp(mix(1.0, o.ao, k), 0.0, 1.0);
    matClass = c;
    matDbgFade = k;
    matDbgDn = r.dn;
    matDbgAo = r.ao;
    return r;
}

// The debug views (sunstoneMatDebug), by the lit colour's brightness: 1 a colour per class (striped dark grey: the World
// detail alone); 2 the detail amount; 3 the normal detail; 4 the cavity.
vec3 MatDebugLand(vec3 col) {
    if (sunstoneMatDebug < 0.5) return col;
    float sh = 0.35 + 0.65 * clamp(MatLum(col) * 1.6, 0.0, 1.0);
    if (sunstoneMatDebug > 3.5) return vec3(matDbgAo);
    if (sunstoneMatDebug > 2.5) return matDbgDn * 4.0 + 0.5;
    if (sunstoneMatDebug > 1.5) return vec3(matDbgFade, 0.0, 0.0) + 0.15 * sh;
    if (matClass <= 0) return vec3(fract((gl_FragCoord.x + gl_FragCoord.y) / 12.0) < 0.5 ? 0.12 : 0.05) * sh;
    float id = float(matClass);
    vec3 c = (0.5 + 0.5 * cos(6.2831 * (fract(id * 7.0 / 26.0) + vec3(0.0, 0.33, 0.67)))) * (mod(id, 2.0) < 0.5 ? 0.6 : 1.0);
    return c * sh;
}
// ---- end _evaluate_land.glsl
// END MATERIALS

float Cmp(vec2 uv, float z) { return shadow2D(shadowMap, vec3(uv, z)).r; }

float EngineFilter(vec3 p, vec2 texel) {
    float s = 0.0;
    for (int y = -1; y <= 1; ++y)
        for (int x = -1; x <= 1; ++x) s += Cmp(p.xy + vec2(float(x), float(y)) * texel, p.z);
    return s / 9.0;
}

// Separable tent-like kernels built from bilinear comparison taps placed between texels, so a wide footprint
// needs few taps and has no noise. `size` is the grid the kernel runs on (the map size, or coarser to widen it).
vec2 Lattice(vec2 uv, float size, out vec2 st) {
    vec2 g = uv * size;
    vec2 b = floor(g + 0.5);
    st = g + 0.5 - b;
    return b - 0.5;
}

float Kernel3(vec3 p, float size) {
    vec2 st;
    vec2 b = Lattice(p.xy, size, st);
    vec2 w0 = 3.0 - 2.0 * st, w1 = 1.0 + 2.0 * st;
    vec2 o0 = (2.0 - st) / w0 - 1.0, o1 = st / w1 + 1.0;
    float inv = 1.0 / size, s = 0.0;
    s += w0.x * w0.y * Cmp((b + vec2(o0.x, o0.y)) * inv, p.z);
    s += w1.x * w0.y * Cmp((b + vec2(o1.x, o0.y)) * inv, p.z);
    s += w0.x * w1.y * Cmp((b + vec2(o0.x, o1.y)) * inv, p.z);
    s += w1.x * w1.y * Cmp((b + vec2(o1.x, o1.y)) * inv, p.z);
    return s / 16.0;
}

float Kernel7(vec3 p, float size) {
    vec2 st;
    vec2 b = Lattice(p.xy, size, st);
    vec2 w[4];
    vec2 o[4];
    w[0] = 5.0 * st - 6.0;
    w[1] = 11.0 * st - 28.0;
    w[2] = -(11.0 * st + 17.0);
    w[3] = -(5.0 * st + 1.0);
    o[0] = (4.0 * st - 5.0) / w[0] - 3.0;
    o[1] = (4.0 * st - 16.0) / w[1] - 1.0;
    o[2] = -(7.0 * st + 5.0) / w[2] + 1.0;
    o[3] = -st / w[3] + 3.0;
    float inv = 1.0 / size, s = 0.0;
    for (int j = 0; j < 4; ++j)
        for (int i = 0; i < 4; ++i) s += w[i].x * w[j].y * Cmp((b + vec2(o[i].x, o[j].y)) * inv, p.z);
    return s / 2704.0;
}

const vec2 kSearch[8] = vec2[8](
    vec2(-0.71, -0.39), vec2(0.17, -0.94), vec2(0.83, -0.33), vec2(0.62, 0.55),
    vec2(-0.05, 0.74), vec2(-0.86, 0.43), vec2(-0.21, -0.12), vec2(0.36, 0.18));

// The receiver's depth change per unit of map uv, from its screen-space derivatives (taken before any branch).
vec2 ReceiverSlope(vec4 sp) {
    vec3 p = sp.xyz / sp.w;
    vec3 dx = dFdx(p), dy = dFdy(p);
    float det = dx.x * dy.y - dx.y * dy.x;
    if (abs(det) < 1e-14) return vec2(0.0);
    return vec2(dy.y * dx.z - dx.y * dy.z, dx.x * dy.z - dy.x * dx.z) / det;
}

float Shadow(vec4 sp, float mode, float nl, vec2 slope) {
    vec3 p = sp.xyz / sp.w;
    if (p.x < 0.0 || p.x > 1.0 || p.y < 0.0 || p.y > 1.0) return 1.0;
    vec2 texel = 1.0 / shadowSize.xy;
    if (mode < 0.5) return EngineFilter(p, texel);

    // Receivers facing away from the sun or edge-on to it shade themselves; that also hides the depth stripes (acne)
    // there. A slope-scaled offset keeps grazing lit slopes clean.
    float facing = smoothstep(0.0, 0.25, nl);
    if (facing <= 0.0) return 0.0;
    // Close to the camera one map texel spans many pixels, so a receiver at a grazing angle to the sun crosses
    // its own depth within a texel: there the offset follows the receiver's slope across the kernel. Receivers
    // facing the sun keep the small offset, so nothing right under its caster lights up.
    float across = (abs(slope.x) + abs(slope.y)) / shadowSize.x;
    float graze = 1.0 - smoothstep(0.15, 0.45, nl);
    p.z -= sunstoneShadowBias * (1.0 + 4.0 * (1.0 - clamp(nl, 0.0, 1.0))) + min(sunstoneShadowSlope * across, 0.004) * graze;

    // Kernel7 spans 3.5 grid cells each side.
    float size = shadowSize.x;
    float softGrid = size / clamp(sunstoneShadowSoftness, 1.0, 2.0);
    if (mode < 1.5) return facing * Kernel7(p, softGrid);

    // Blocker estimate from comparisons alone: the share of search taps occluded by something at least t closer
    // to the light, for a few t, integrates to the mean blocker distance.
    float d = max(sunstoneShadowContact, 1e-5);
    float r = 3.5 / softGrid;
    float o0 = 0.0, o1 = 0.0, o2 = 0.0;
    for (int i = 0; i < 8; ++i) {
        vec2 uv = p.xy + kSearch[i] * r;
        o0 += 1.0 - Cmp(uv, p.z);
        o1 += 1.0 - Cmp(uv, p.z - d * 0.25);
        o2 += 1.0 - Cmp(uv, p.z - d * 0.6);
    }
    if (o0 < 0.5) return facing;
    float mean = clamp((0.125 * (o0 + o1) + 0.175 * (o1 + o2) + 0.4 * o2) / o0, 0.0, 1.0);
    float sharp = Kernel3(p, size);
    if (mean < 0.02) return facing * sharp;
    return facing * mix(sharp, Kernel7(p, softGrid), smoothstep(0.0, 1.0, mean));
}

float Luma(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); }

float Hash(vec2 p) {
    vec3 q = fract(vec3(p.xyx) * 0.1031);
    q += dot(q, q.yzx + 33.33);
    return fract((q.x + q.y) * q.z);
}

// Value noise in x (0..1) and its derivative in yz.
vec3 NoiseD(vec2 x) {
    vec2 i = floor(x), f = fract(x);
    vec2 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    vec2 du = 30.0 * f * f * (f * (f - 2.0) + 1.0);
    float a = Hash(i), b = Hash(i + vec2(1.0, 0.0)), c = Hash(i + vec2(0.0, 1.0)), d = Hash(i + vec2(1.0, 1.0));
    float k1 = b - a, k2 = c - a, k4 = a - b - c + d;
    return vec3(a + k1 * u.x + k2 * u.y + k4 * u.x * u.y, du * vec2(k1 + k4 * u.y, k2 + k4 * u.x));
}

// Two value noises on lattices turned against each other, so no grid shows; centred (about -0.5..0.5) in x, its
// gradient in yz.
vec3 Clump(vec2 p) {
    const mat2 r = mat2(0.6, 0.8, -0.8, 0.6);
    vec3 a = NoiseD(p), b = NoiseD(r * p * 1.37 + 4.1);
    return vec3(a.x + b.x - 1.0, a.yz + transpose(r) * b.yz * 1.37) * 0.5;
}

// World position projected on the plane most facing the surface; ax0 and ax1 are the world axes of the plane.
vec2 Project(vec3 pw, vec3 nw, out vec3 ax0, out vec3 ax1) {
    vec3 a = abs(nw);
    if (a.y >= a.x && a.y >= a.z) {
        ax0 = vec3(1.0, 0.0, 0.0);
        ax1 = vec3(0.0, 0.0, 1.0);
    } else if (a.x >= a.z) {
        ax0 = vec3(0.0, 0.0, 1.0);
        ax1 = vec3(0.0, 1.0, 0.0);
    } else {
        ax0 = vec3(1.0, 0.0, 0.0);
        ax1 = vec3(0.0, 1.0, 0.0);
    }
    return vec2(dot(pw, ax0), dot(pw, ax1));
}

// Two octaves (periods 6 and 1.5 world units), each faded out once a pixel covers a quarter of its period so it
// never shimmers. Returns the centred value (about -1..1) in x and its gradient per world unit in yz.
vec3 DetailNoise(vec2 uv, float footprint) {
    vec3 a = NoiseD(uv / 6.0), b = NoiseD(uv / 1.5);
    float wa = 0.65 * (1.0 - smoothstep(1.5, 4.5, footprint));
    float wb = 0.35 * (1.0 - smoothstep(0.375, 1.125, footprint));
    float v = wa * a.x + wb * b.x - 0.5 * (wa + wb);
    vec2 g = wa * a.yz / 6.0 + wb * b.yz / 1.5;
    return vec3(2.0 * v, 2.0 * g);
}

// Bump from the texture's brightness: brighter texels stand proud by up to `depth` world units. The surface gradient
// is built from screen-space derivatives of the eye-space position, so no tangents are needed.
vec3 Relief(vec3 n, vec3 p, vec2 uv, float h0, float depth) {
    // Steps shorter than about a texel would only see the bilinear ramp between two texels (stair lines), so
    // magnified textures take a longer step and scale the difference back down.
    vec2 dx = dFdx(uv), dy = dFdy(uv);
    float kx = max(1.0, 0.004 / max(length(dx), 1e-6)), ky = max(1.0, 0.004 / max(length(dy), 1e-6));
    float hx = (Luma(texture2D(texture0, uv + dx * kx).rgb) - h0) / kx;
    float hy = (Luma(texture2D(texture0, uv + dy * ky).rgb) - h0) / ky;
    vec3 sx = dFdx(p), sy = dFdy(p);
    vec3 r1 = cross(sy, n), r2 = cross(n, sx);
    float det = dot(sx, r1);
    vec3 g = sign(det) * (hx * r1 + hy * r2) * depth;
    return normalize(abs(det) * n - g);
}

float Hue(vec3 c, out float s) {
    float mx = max(c.r, max(c.g, c.b)), C = mx - min(c.r, min(c.g, c.b));
    s = C / max(mx, 1e-4);
    if (C < 1e-4) return 0.0;
    float h = mx == c.r ? (c.g - c.b) / C : (mx == c.g ? 2.0 + (c.b - c.r) / C : 4.0 + (c.r - c.g) / C);
    return fract(h / 6.0) * 360.0;
}

vec3 Hsv(float h, float s, float v) {
    vec3 k = clamp(abs(fract(h / 360.0 + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0) - 1.0, 0.0, 1.0);
    return v * mix(vec3(1.0), k, s);
}

// Pulls the meadow's saturated mid greens toward yellow-green and caps their chroma; green is the texture's foliage
// weight, so painted props and water never move.
vec3 Meadow(vec3 c, float green, float lit) {
    if (sunstoneFoliage <= 0.0 || green <= 0.0) return c;
    float S, H = Hue(c, S);
    float mx = max(c.r, max(c.g, c.b));
    float w = smoothstep(0.25, 0.45, S) * smoothstep(100.0, 125.0, H) * (1.0 - smoothstep(155.0, 175.0, H)) * green;
    S = mix(S, min(S, 0.35 + (S - 0.35) * 0.4), w * sunstoneFoliageCap);
    return Hsv(H - sunstoneFoliage * w * mix(sunstoneShadeShift, 1.0, lit), S, mx * (1.0 - 0.08 * w * sunstoneFoliageCap));
}

vec3 GameLight(vec3 n, vec3 v, vec3 l, float lit, vec3 albedo) {
    float ndl = clamp(dot(n, l) * lit, 0.0, 1.0);
    float spec = lit * pow(clamp(dot(n, normalize(l + v)), 0.0, 1.0), 20.0);
    float rim = clamp(pow(max(1.0 - dot(v, n), 0.0), 1.5), 0.0, 1.0);
    vec3 add = globalSpecular * 0.6 * spec + (0.5 + 0.5 * lit) * vec3(0.2, 0.275, 0.175) * globalFresnel * rim;
    return (globalDiffuse * ndl + globalAmbient) * albedo + add;
}

// 1 on open meadow, 0 on tree canopies and steep banks (set in Shade).
float meadow = 1.0;
// Material detail's light terms (set in Shade): specular and gloss scales, cavity (ambient all of it, the sun a third).
float matSpec = 1.0, matGlossK = 1.0, matAo = 1.0;

// green is the foliage weight (0..1): wrapped diffuse and back-transmission apply to it only.
vec3 SunstoneLight(vec3 n, vec3 v, vec3 l, vec3 up, float lit, vec3 albedo, float gloss, float green) {
    float ndl = max(dot(n, l), 0.0);
    float wrap = sunstoneGrassWrap * green;
    float ndlWrapped = max((dot(n, l) + wrap) / (1.0 + wrap), 0.0);
    // Canopies and steep banks take less of the warm light, so sunlit tree tops do not turn lime.
    float warm = sunstoneGreenWarm * green * mix(0.3, 1.0, meadow);
    vec3 sun = globalDiffuse * mix(vec3(1.0), sunstoneSunTint, sunstoneTint) * sunstoneSunGain * mix(vec3(1.0), vec3(1.08, 1.0, 0.78), warm);
    vec3 shadowTint = mix(vec3(1.0), sunstoneShadowTint, sunstoneTint) * mix(vec3(1.0), vec3(1.16, 1.0, 0.7), warm);
    float f0 = sunstoneSpecular * gloss * matSpec;
    float power = max(sunstoneGloss * matGlossK, 1.0);
    vec3 h = normalize(l + v);
    float fres = f0 * (1.0 + 3.0 * pow(1.0 - clamp(dot(l, h), 0.0, 1.0), 5.0));
    float spec = fres * (power + 8.0) / 8.0 * pow(max(dot(n, h), 0.0), power) * ndl * lit;

    float sky = dot(n, up) * 0.5 + 0.5;
    float s = sky * sky * (3.0 - 2.0 * sky);
    vec3 ambient = globalAmbient * sunstoneAmbientGain * mix(sunstoneGround, sunstoneSky, s);
    ambient *= 1.0 - sunstoneShadowAmbient * (1.0 - lit) * clamp(dot(up, l) * 2.0, 0.0, 1.0);
    ambient *= mix(vec3(1.0), shadowTint, 1.0 - lit);

    float edge = pow(max(1.0 - max(dot(n, v), 0.0), 0.0), 3.0);
    float back = clamp(0.5 - 0.5 * dot(v, l), 0.0, 1.0);
    vec3 rim = sunstoneRim * edge * back * lit * globalDiffuse;

    vec3 diffuse = sun * ndlWrapped * lit * (1.0 - f0) * (1.0 - (1.0 - matAo) / 3.0);
    float through = pow(clamp(dot(v, -l), 0.0, 1.0), 2.0);
    vec3 transmit = sun * vec3(0.5, 0.6, 0.1) * (sunstoneTransmit * green * through * lit);
    // Shade keeps the colour of what it falls on rather than greying toward the sky's tint.
    vec3 fill = ambient * albedo * matAo;
    fill = max(mix(vec3(Luma(fill)), fill, 1.0 + sunstoneShadeChroma * (1.0 - lit)), 0.0);
    return (diffuse + rim + transmit) * albedo + fill + globalSpecular * spec;
}

// Brightness above the knee rolls off toward white, as film does, so bright sand and stone stay pale rather than
// clipping. Rolled per channel, bright warm surfaces turn yellower as the game's clipped lighting draws them;
// sunstoneRollHue blends toward a roll-off that keeps the hue.
vec3 Shoulder(vec3 c) {
    float m = max(c.r, max(c.g, c.b));
    if (m <= 0.85) return c;
    float r = 0.85 + 0.15 * (1.0 - exp((0.85 - m) / 0.15));
    vec3 kept = mix(c * (r / m), vec3(r), clamp((m - 0.85) / m, 0.0, 1.0));
    vec3 each = mix(c, 0.85 + 0.15 * (1.0 - exp((0.85 - c) / 0.15)), step(0.85, c));
    return mix(each, kept, sunstoneRollHue);
}

vec4 Shade(float vertexAlpha, vec4 vertexColour, bool useVertexColour) {
    vec3 n = normalize(gl_TexCoord[2].xyz);
    vec3 v = normalize(gl_TexCoord[1].xyz);
    vec3 l = normalize(-gl_TexCoord[3].xyz);
    vec2 uv = gl_TexCoord[0].xy;
    vec4 tex = texture2D(texture0, uv);
    bool left = gl_FragCoord.x < sunstoneSplit;
    float mode = sunstoneLight > 9.5 ? sunstoneLight - 10.0 : sunstoneLight;
    bool showShadow = sunstoneShadowMode > 9.5;
    float shadowMode = left ? 0.0 : (showShadow ? sunstoneShadowMode - 10.0 : sunstoneShadowMode);
    vec2 slope = ReceiverSlope(gl_TexCoord[4]);

    vec3 albedo = sunstoneLight > 9.5 ? vec3(0.5) : tex.rgb;
    vec3 c;
    float lit;
    if (left || mode < 0.5) {
        lit = Shadow(gl_TexCoord[4], shadowMode, dot(n, l), slope);
        c = GameLight(n, v, l, lit, albedo);
    } else {
        if (sunstoneDebug > 3.5) return vec4(0.5 + 0.5 * (transpose(mat3(view)) * l), 1.0);
        vec3 up = view[1].xyz;
        up = dot(up, up) > 0.25 ? normalize(up) : l;
        float h0 = Luma(tex.rgb);
        vec3 p = -gl_TexCoord[1].xyz;
        float dist = length(p);
        float facing = smoothstep(0.04, 0.2, dot(n, v));
        float fade = (1.0 - smoothstep(0.25, 1.0, dist / max(sunstoneReliefFade, 1.0))) * facing;
        // Where a texel spans several pixels the relief would only emboss the texel grid, so it fades out.
        vec2 texels = vec2(textureSize(texture0, 0));
        float texelsPerPixel = max(length(dFdx(uv) * texels), length(dFdy(uv) * texels)) * max(sunstoneRenderScale, 1.0);
        fade *= smoothstep(0.5, 1.0, texelsPerPixel);
        vec3 nb = Relief(n, p, uv, h0, sunstoneRelief * fade);

        // World-space detail: independent of the texture's texels, so it only adds where the texture is magnified
        // and fades with distance.
        float green = smoothstep(0.05, 0.15, tex.g - max(tex.r, tex.b));
        lit = Shadow(gl_TexCoord[4], shadowMode, dot(n, l), slope);
        // Full shift on open meadow, less on steep banks, on tree canopies (rounded: the normal turns quickly across
        // the surface) and in shade.
        float curve = length(fwidth(n)) / max(length(fwidth(p)), 1e-4);
        meadow = smoothstep(0.35, 0.85, dot(n, up)) * (1.0 - smoothstep(0.5, 1.5, curve / max(sunstoneCanopy, 1e-5)));
        albedo = Meadow(albedo, green * mix(0.4, 1.0, meadow), lit);
        // Material detail (tools/materials, _evaluate_land.glsl): the class of this draw's tile from Melange's tag (a
        // uniform branch). Where it draws it takes the place of the World detail's noise below; the texture relief, the
        // meadow and the tufts stay.
        float matK = 0.0;
        int mc = MatEnabled() ? MatLandClass() : 0;
        if (mc > 0) {
            MatIn mi = MatSetupLand(vec4(albedo, tex.a), uv);
            if (mi.fade > 0.0) {
                MatOut mo = MatEvaluateLand(mi, mc);
                albedo = mo.albedo;
                nb = normalize(nb + mo.dn);
                matSpec = mo.spec;
                matGlossK = mo.gloss;
                matAo = mo.ao;
                matK = clamp(matDbgFade, 0.0, 1.0);
            }
            matClass = mc;
        }
        float detail = 0.0;
        if (dot(view[1].xyz, view[1].xyz) > 0.25) {
            mat3 rot = mat3(view);
            vec3 pw = transpose(rot) * (p - view[3].xyz);
            vec3 ax0, ax1;
            vec2 wuv = Project(pw, transpose(rot) * n, ax0, ax1);
            float reach = max(sunstoneDetailFade, 1.0);
            float dw = mix(0.35, 1.0, 1.0 - smoothstep(0.5, 1.0, texelsPerPixel))
                * (1.0 - smoothstep(0.375 * reach, reach, dist)) * facing * (1.0 - matK);
            float fpw = max(fwidth(wuv.x), fwidth(wuv.y));
            vec3 dn = dw > 0.0 ? DetailNoise(wuv, fpw) : vec3(0.0);
            vec3 ge = rot * (dn.y * ax0 + dn.z * ax1);
            nb = normalize(nb - sunstoneDetailBump * dw * (ge - nb * dot(ge, nb)));
            albedo *= 1.0 + sunstoneDetail * dw * dn.x;
            float patch = 0.55 * NoiseD(wuv / 80.0).x + 0.45 * NoiseD(wuv / 360.0 + 3.1).x;
            albedo *= 1.0 + sunstonePatch * green * 2.0 * (patch - 0.5);
            float hp = NoiseD(wuv / 45.0 + 7.3).x;
            vec3 hueTint = mix(mix(vec3(1.0), vec3(0.94, 1.0, 1.08), 1.0 - smoothstep(0.15, 0.5, hp)), vec3(1.12, 1.03, 0.76),
                               smoothstep(0.5, 0.85, hp));
            albedo *= mix(vec3(1.0), hueTint, sunstonePatchHue * green);
            // Clumps of grass, slightly longer along the wind, at three sizes: darker and cooler in the gaps, warmer
            // on top, and tilted so the sun lights one side of each. Each octave fades before it would shimmer.
            mat2 windRot = mat2(0.8, 0.6, -0.6, 0.8);
            vec2 wind = windRot * wuv;
            float fp = max(fwidth(wuv.x), fwidth(wuv.y));
            vec3 ca = Clump(wind * vec2(0.0625, 0.125));
            vec3 cb = Clump(wind * vec2(0.2, 0.4) + 5.7);
            vec3 cc = Clump(wind * vec2(0.625, 1.25) + 2.3);
            float wa = 0.7 * (1.0 - smoothstep(2.0, 4.0, fp));
            float wb = 0.9 * (1.0 - smoothstep(0.6, 1.2, fp));
            float wc = 0.8 * (1.0 - smoothstep(0.2, 0.4, fp));
            float k = sunstoneTuft * green * meadow;
            float tuft = (wa * ca.x + wb * cb.x + wc * cc.x) * k;
            albedo *= 1.0 + tuft * 2.6 * vec3(1.05, 1.0, 0.72);
            vec2 tilt = transpose(windRot) * (wa * ca.yz + wb * cb.yz + wc * cc.yz) * k;
            vec3 gt = rot * (tilt.x * ax0 + tilt.y * ax1);
            nb = normalize(nb - gt + nb * dot(gt, nb));
            detail = dn.x * dw;
            if (sunstoneDebug > 0.5 && sunstoneDebug < 1.5) return vec4(fract(pw / 100.0), 1.0);
        }
        if (sunstoneDebug > 1.5 && sunstoneDebug < 2.5) return vec4(vec3(0.5 + 0.5 * detail), 1.0);
        if (sunstoneDebug > 2.5) return vec4(green, green * meadow, 0.0, 1.0);
        float gloss = (0.5 + h0) * (1.0 - sunstoneGreenSpec * green);
        c = SunstoneLight(nb, v, l, up, lit, albedo, gloss, green);
        // Grass catches the sky at grazing angles.
        float graze = pow(1.0 - max(dot(nb, v), 0.0), 4.0);
        c += globalAmbient * sunstoneSky * (sunstoneSheen * green * meadow * graze * (0.5 + 0.5 * lit));
        c = MatDebugLand(Shoulder(c));
    }
    if (showShadow) return vec4(vec3(lit), 1.0);
    vec4 o = vec4(clamp(c, 0.0, 1.0), tex.a);
    return useVertexColour ? o * vertexColour : vec4(o.rgb, o.a * vertexAlpha);
}

void main() { gl_FragColor = Shade(gl_Color.a, gl_Color, true); }
