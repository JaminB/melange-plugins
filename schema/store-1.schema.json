{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JaminB/melange-plugins/schema/store-1.schema.json",
  "title": "plugins/<id>/store.json",
  "description": "Store-only metadata for a plugin. Everything spice.json already says (id, version, name, authors, description, website, melange.range, kind, permissions, dependencies, conflicts) is not repeated here.",
  "type": "object",
  "required": ["storeVersion", "licence", "categories", "gameBuilds"],
  "additionalProperties": false,
  "properties": {
    "storeVersion": { "const": 1 },
    "licence": {
      "type": "string",
      "enum": [
        "MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "Zlib",
        "MPL-2.0", "LGPL-3.0-or-later", "GPL-3.0-or-later", "CC0-1.0",
        "CC-BY-4.0", "CC-BY-SA-4.0", "Unlicense"
      ]
    },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 200 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["graphics", "gameplay", "maps", "weapons", "audio", "interface", "tools", "libraries"]
      }
    },
    "gameBuilds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["1077"] }
    },
    "screenshots": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": ["file"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string", "pattern": "^[0-9]+\\.(png|jpg|jpeg)$" },
          "caption": { "type": "string", "maxLength": 120 }
        }
      }
    },
    "imports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "Shown in the Store's install confirm for a plugin with an importer (mod/spice.json's importer key). Informational only; the real source facts are in the recipe.",
      "items": {
        "type": "object",
        "required": ["title", "publisher", "host", "size"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 400 },
          "publisher": { "type": "string", "minLength": 1, "maxLength": 400 },
          "host": { "type": "string", "minLength": 1, "maxLength": 253 },
          "size": { "type": "integer", "minimum": 1, "maximum": 536870912 }
        }
      }
    },
    "versions": {
      "type": "array",
      "maxItems": 50,
      "description": "Written only by release.yml. Immutable per entry except yanked.",
      "items": {
        "type": "object",
        "required": [
          "version", "released", "melange", "kind", "permissions",
          "dependencies", "conflicts", "url", "sha256", "size",
          "unpackedSize", "files", "changelog"
        ],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string" },
          "released": { "type": "string", "format": "date" },
          "melange": { "type": "string" },
          "kind": { "type": "string", "enum": ["client-only", "content"] },
          "permissions": {
            "type": "object",
            "required": ["unsafe", "filesystem"],
            "additionalProperties": false,
            "properties": {
              "unsafe": { "type": "boolean" },
              "filesystem": { "type": "string" }
            }
          },
          "dependencies": { "type": "array", "items": { "type": "object" } },
          "conflicts": { "type": "array", "items": { "type": "object" } },
          "url": {
            "type": "string",
            "pattern": "^https://github\\.com/JaminB/melange-plugins/releases/download/[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?-v[^/]+/[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?-[^/]+\\.zip$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "unpackedSize": { "type": "integer", "minimum": 1 },
          "files": { "type": "integer", "minimum": 1 },
          "changelog": { "type": "string", "maxLength": 2000 },
          "yanked": { "type": "boolean" }
        }
      }
    }
  }
}
