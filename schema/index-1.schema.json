{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/JaminB/melange-plugins/schema/index-1.schema.json",
  "title": "index.json",
  "description": "Generated by tools/store.py index. Never hand-edited. Caps: 1 MiB, 500 plugins, 50 versions per plugin.",
  "type": "object",
  "required": ["indexVersion", "serial", "plugins"],
  "additionalProperties": false,
  "properties": {
    "indexVersion": { "const": 1 },
    "serial": { "type": "integer", "minimum": 0 },
    "plugins": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id", "name", "authors", "description", "licence",
          "categories", "gameBuilds", "screenshots", "versions"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 80 },
          "authors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "description": { "type": "string", "minLength": 1, "maxLength": 400 },
          "homepage": { "type": "string" },
          "licence": { "type": "string" },
          "categories": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
          "gameBuilds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "screenshots": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": ["path", "sha256", "size"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "size": { "type": "integer", "minimum": 1 },
                "caption": { "type": "string", "maxLength": 120 }
              }
            }
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": { "type": "object" }
          },
          "imports": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "object" }
          }
        }
      }
    }
  }
}
