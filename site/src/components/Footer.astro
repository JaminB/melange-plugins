---
// Starlight Footer override: the stock footer (edit link, last updated, pagination), then the site footer with the
// non-affiliation notice, which must appear on every page. Also wires up the SHA-256 Copy buttons that the generated
// plugin pages emit (button[data-mel-copy] next to code.mel-sha__value).
import Default from '@astrojs/starlight/components/Footer.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Default />
<div class="mel-footer mel-site-footer not-content">
	<div class="mel-wrap">
		<p class="mel-footer__links">
			<span>Melange Plugins is open source (MIT).</span>
			<a href="https://github.com/JaminB/melange-plugins">GitHub</a>
			<a href="https://jaminb.github.io/melange/">Melange site</a>
			<a href={`${base}/publish/`}>Publish a plugin</a>
			<a href={`${base}/about/`}>About and privacy</a>
		</p>
		<p class="mel-footer__tm">
			Worms and Worms Ultimate Mayhem are trademarks of Team17 Digital Limited. Melange is an independent fan
			project and is not affiliated with, sponsored by, or endorsed by Team17.
		</p>
	</div>
</div>

<script>
	for (const btn of document.querySelectorAll<HTMLButtonElement>('button[data-mel-copy]')) {
		btn.addEventListener('click', async () => {
			const row = btn.closest('.mel-sha__row');
			const text = row?.querySelector('.mel-sha__value')?.textContent?.trim() ?? '';
			const status = row?.querySelector('[role="status"]');
			try {
				await navigator.clipboard.writeText(text);
				btn.textContent = 'Copied';
				if (status) status.textContent = 'SHA-256 copied';
			} catch {
				btn.textContent = 'Select it';
			}
			setTimeout(() => {
				btn.textContent = 'Copy';
				if (status) status.textContent = '';
			}, 1600);
		});
	}
</script>
