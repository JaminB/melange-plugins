---
// The not-found page (Starlight's own 404 route is disabled in astro.config.mjs so this one, with the site's
// footer and nav, is used instead; GitHub Pages serves dist/404.html for unknown URLs).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage
	frontmatter={{
		title: 'Page not found',
		description: 'This page is not in the Melange plugin catalogue.',
		template: 'splash',
		editUrl: false,
		lastUpdated: false,
		pagefind: false,
	}}
>
	<p>
		That page isn't here. Plugin pages live at <code>/melange-plugins/plugins/&lt;id&gt;/</code>; a plugin that was
		withdrawn from the Store is no longer listed.
	</p>
	<p class="not-content mel-404-links">
		<a class="mel-btn" href={`${base}/`}>Back to the catalogue</a>
		<a href={`${base}/publish/`}>Publish a plugin</a>
	</p>
</StarlightPage>
